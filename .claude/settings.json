{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint 2>&1 | tail -50 || true",
            "statusMessage": "Running lint (astro check)..."
          }
        ]
      }
    ]
  }
}
