---
export interface Props {
  title?: string;
  requireChannel?: string; // 이 값이 있으면 해당 채널 이용권이 유효할 때만 콘텐츠 접근 허용
}
const { title = 'TAERIJAY', requireChannel = '' } = Astro.props;

const FIREBASE_API_KEY = "AIzaSyDohULKEyCcSi30UpbLJSwPwHJ0Vad8J5M";
const FIREBASE_AUTH_DOMAIN = "taerijay-official.firebaseapp.com";
const FIREBASE_PROJECT_ID = "taerijay-official";

const CHANNEL_LABELS = {
  protocol: 'protocol',
  mini: 'mini',
  red: 'red',
  green: 'green',
  'mart-convenience': 'mart+convenience',
};

const channels = {
  entertainment: { slug: 'entertainment', color: '#00E5FF' },
  protocol:      { slug: 'protocol',      color: '#F16B24' },
  mini:          { slug: 'mini',          color: '#e8e4dc' },
  red:           { slug: 'red',           color: '#E1261C' },
  green:         { slug: 'green',         color: '#6F8B2E' },
  martCvs:       { slug: 'mart-convenience', color: '#FFDD00' },
};

const SOCIAL_URLS = {
  youtube: 'https://www.youtube.com/@taerijay',
  instagram: 'https://www.instagram.com/taerijay_official/',
  tiktok: 'https://www.tiktok.com/@taerijay',
  google: 'https://www.blogger.com/u/2/blog/posts/8380419980383417351',
  naver: 'https://blog.naver.com/taerijay',
};

import { languages } from '../lib/languages.js';
---
<!doctype html>
<html lang="ko">
<head>
