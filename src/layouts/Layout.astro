      </a>
      <a href={SOCIAL_URLS.naver} target="_blank" rel="noopener noreferrer" class="social-icon social-naver" title="Naver Blog" aria-label="Naver Blog">
        <svg viewBox="0 0 24 24" width="20" height="20"><rect width="24" height="24" rx="6" fill="#03C75A"/><path fill="#fff" d="M14.4 13.6 9.7 6.5H6.5v11h3.1v-7.1l4.7 7.1h3.2v-11h-3.1v7.1Z"/></svg>
      </a>
    </div>
    <p class="footer-copy">© 2026 <span class="notranslate" translate="no">TAERIJAY</span> · 사업자등록번호 673-51-01148 · <span class="notranslate" translate="no">taerijay.com</span></p>
  </footer>

  <script>
    const nav = document.getElementById('nav');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 40) nav.classList.add('nav-scrolled');
      else nav.classList.remove('nav-scrolled');
    });

    const hamburgerBtn = document.getElementById('hamburger-btn');
    const sideMenu = document.getElementById('side-menu');
    const sideClose = document.getElementById('side-close');
    hamburgerBtn.addEventListener('click', () => { sideMenu.hidden = false; });
    sideClose.addEventListener('click', () => { sideMenu.hidden = true; });
    sideMenu.addEventListener('click', (e) => { if (e.target === sideMenu) sideMenu.hidden = true; });

    const navBackBtn = document.getElementById('nav-back-btn');
    if (navBackBtn) {
      navBackBtn.addEventListener('click', () => {
        if (window.history.length > 1) history.back();
        else window.location.href = '/';
      });
    }

    const langTrigger = document.getElementById('lang-trigger');
    const langMenu = document.getElementById('lang-menu');
    const langCurrent = document.getElementById('lang-current');

    langTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      langMenu.hidden = !langMenu.hidden;
    });

    document.querySelectorAll('.lang-option').forEach((opt) => {
      opt.addEventListener('click', () => {
        langCurrent.textContent = opt.dataset.name;
        localStorage.setItem('taerijay_lang', opt.dataset.code);
        langMenu.hidden = true;
        translatePage(opt.dataset.code);
      });
    });

    // 구글 번역 엔진 연동 — 선택한 언어로 페이지 전체 실시간 번역
    // 한글(-kr)은 절대 고정값: notranslate + translate="no"가 개별 요소에 적용되어 있어
    // 어떤 언어를 선택해도 항상 그대로 보인다. 영문(-en)은 기본값이자 가변값으로,
    // 선택한 언어에 따라 구글 번역이 그 자리만 번역해 보여준다.
    //
    // 모바일(특히 iOS Safari, 저속 네트워크)에서는 구글 번역 스크립트/iframe 로딩이
    // PC보다 훨씬 느리거나 아예 지연되는 경우가 흔하다. 그래서 재시도 총 대기 시간을
    // 5초(250ms×20회)에서 최대 약 20초(300ms씩 점증)까지 늘리고, 시간 안에 위젯이
    // 끝내 준비되지 않으면 조용히 실패하는 대신 사용자에게 안내를 보여준다.
    let translateWidgetReady = false;
    let pendingLangCode = null;

    function showTranslateNotice(show) {
      const notice = document.getElementById('translate-notice');
      if (notice) notice.hidden = !show;
    }

    // ── 모바일 API 번역 (Google Translation API 직접 호출) ──────────────────
    // 구글 웹사이트 번역 위젯이 모바일에서 구조적으로 불안정한 문제를 근본적으로
    // 피하기 위해, 모바일 + 아래 지원 언어 조합일 때는 위젯 대신 이 방식을 사용한다.
    // 한글(-kr) 요소는 건드리지 않고, 영문(-en, notranslate 없는 것만) 요소의 텍스트만
    // /api/translate 로 보내 번역 결과로 교체한다. 원문은 data-orig-en에 백업해뒀다가
    // 한국어로 되돌릴 때 그대로 복원한다.
    // 2026-08 4차 확장: PC 구글 번역 위젯과 동일하게 languages.js 전체 135개 언어(한국어 제외)를
    // 모바일에서도 지원 — .lang-option 버튼 목록(아래 languages.map으로 렌더링됨)에서
    // data-code를 그대로 수집해 API 번역 대상 집합을 만든다(하드코딩 목록 유지 불필요).
    const API_TRANSLATE_TARGETS = new Set(
      Array.from(document.querySelectorAll('.lang-option'))
        .map((opt) => opt.dataset.code)
        .filter((code) => code && code !== 'ko')
    );

    function isMobileViewport() {
      return window.matchMedia('(max-width: 768px)').matches;
    }

    function collectTranslatableEls() {
      // class 이름이 "-en"으로 끝나는 요소만 대상. notranslate가 붙은 요소는 고정 텍스트라 제외.
      return Array.from(document.querySelectorAll('[class*="-en"]')).filter((el) => {
        if (el.classList.contains('notranslate')) return false;
        if (!Array.from(el.classList).some((c) => c.endsWith('-en'))) return false;
        const text = el.textContent.trim();
        return text.length > 0;
      });
    }

    function restoreOriginalEnText() {
      document.querySelectorAll('[data-orig-en]').forEach((el) => {
        el.textContent = el.getAttribute('data-orig-en');
      });
    }

    // 같은 페이지 안에서 같은 언어로 다시 전환할 때 API를 또 호출하지 않도록 localStorage에 캐싱.
    // 키는 페이지 경로+언어 기준이라 페이지가 바뀌면 새로 캐싱된다.
    // v2: /api/translate가 source:'ko'를 잘못 고정해 SINGLE/PRO 등 영어 원문이 번역되지 않고
    // 그대로 캐싱된 적이 있어, 버전을 올려 기존 사용자의 잘못된 캐시를 무효화한다.
    function getCacheKey(code) {
      return `tj_translate_cache_v2_${code}_${window.location.pathname}`;
    }

    async function translateViaApi(code) {
      const els = collectTranslatableEls();
      if (!els.length) return;

      els.forEach((el) => {
        if (!el.hasAttribute('data-orig-en')) {
          el.setAttribute('data-orig-en', el.textContent);
        }
      });

      const cacheKey = getCacheKey(code);
      let cached = null;
      try {
        const raw = localStorage.getItem(cacheKey);
        if (raw) cached = JSON.parse(raw);
      } catch {}

      if (cached && Array.isArray(cached) && cached.length === els.length) {
        els.forEach((el, i) => { if (cached[i]) el.textContent = cached[i]; });
        return;
      }

      const texts = els.map((el) => el.getAttribute('data-orig-en'));
      try {
        const res = await fetch('/api/translate', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ texts, target: code }),
        });
        if (!res.ok) throw new Error('translate api failed');
        const data = await res.json();
        const translations = data.translations || [];
        els.forEach((el, i) => {
          if (translations[i]) el.textContent = translations[i];
        });
        try {
          localStorage.setItem(cacheKey, JSON.stringify(translations));
        } catch {}
      } catch (e) {
        console.error('[translate] api translate failed', e);
        showTranslateNotice(true);
      }
    }

    function translatePage(code) {
      if (code === 'ko') {
        const combo = document.querySelector('.goog-te-combo');
        if (combo) { combo.value = ''; combo.dispatchEvent(new Event('change')); }
        document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
        restoreOriginalEnText();
        showTranslateNotice(false);
        return;
      }

      // 모바일 + API 지원 언어 조합이면 구글 위젯 대신 번역 API로 직접 처리
      if (isMobileViewport() && API_TRANSLATE_TARGETS.has(code)) {
        showTranslateNotice(false);
        translateViaApi(code);
        return;
      }

      const gCode = code === 'zh-HK' ? 'zh-TW' : code;
      pendingLangCode = gCode;
      showTranslateNotice(false);
      const MAX_ATTEMPTS = 45; // 약 20초까지 재시도 (모바일 저속 로딩 대응)
      const trySetCombo = (attempt) => {
        const combo = document.querySelector('.goog-te-combo');
        if (combo) {
          translateWidgetReady = true;
          combo.value = gCode;
          combo.dispatchEvent(new Event('change'));
          showTranslateNotice(false);
          pendingLangCode = null;
        } else if (attempt < MAX_ATTEMPTS) {
          setTimeout(() => trySetCombo(attempt + 1), 450);
        } else {
          // 20초 동안 위젯이 준비되지 않음 — 네트워크/브라우저 차단 가능성.
          // 조용히 포기하지 않고 사용자에게 상태를 알린다.
          showTranslateNotice(true);
        }
      };
      trySetCombo(0);
    }

    window.googleTranslateElementInit = function () {
      new google.translate.TranslateElement({ pageLanguage: 'ko', autoDisplay: false }, 'google_translate_element');
      translateWidgetReady = true;
      // 위젯이 초기화된 시점에 대기 중이던 언어 선택이 있으면 즉시 적용
      // (단, 모바일+API 지원 언어는 아래 즉시 실행 블록에서 이미 처리됐을 수 있어 중복 호출을 피함)
      if (pendingLangCode) {
        translatePage(pendingLangCode === 'zh-TW' ? 'zh-HK' : pendingLangCode);
        return;
      }
      const saved = localStorage.getItem('taerijay_lang');
      if (saved && saved !== 'ko' && !(isMobileViewport() && API_TRANSLATE_TARGETS.has(saved))) {
        translatePage(saved);
      }
    };

    // 모바일 + API 지원 언어 조합이면 구글 스크립트 로딩을 기다리지 않고 페이지 로드 즉시 번역 적용
    // (이미 저장된 언어가 있는 재방문 사용자를 위함 — 첫 방문은 기본값 한국어라 별도 처리 불필요)
    (function initMobileApiTranslateOnLoad() {
      const saved = localStorage.getItem('taerijay_lang');
      if (saved && saved !== 'ko' && isMobileViewport() && API_TRANSLATE_TARGETS.has(saved)) {
        translatePage(saved);
      }
    })();

    // 구글 번역 스크립트 로드 자체가 실패한 경우(광고 차단기, 네트워크 정책 등)를 대비한 안전장치.
    // 12초 안에 초기화 콜백이 오지 않고, 사용자가 실제로 한국어가 아닌 언어를 선택한 상태일 때만 안내를 띄운다.
    // (langCurrent에 표시된 현재 선택 언어를 기준으로 판단 — localStorage 잔여값만으로는 판단하지 않는다)
    setTimeout(() => {
      const saved = localStorage.getItem('taerijay_lang');
      const isKorean = !saved || saved === 'ko' || langCurrent.textContent.trim() === '한국어';
      if (!translateWidgetReady && !isKorean) {
        showTranslateNotice(true);
      }
    }, 12000);

    document.addEventListener('click', (e) => {
      if (!langMenu.hidden && !e.target.closest('.lang-dropdown')) {
        langMenu.hidden = true;
      }
    });

    window.addEventListener('DOMContentLoaded', () => {
      const saved = localStorage.getItem('taerijay_lang');
      if (saved) {
        const opt = document.querySelector(`.lang-option[data-code="${saved}"]`);
        if (opt) langCurrent.textContent = opt.dataset.name;
      }
      setTimeout(() => {
        const s = document.getElementById('splash');
        if (s) { s.style.opacity = '0'; setTimeout(() => s.remove(), 500); }
      }, 700);

      const kr = document.getElementById('nav-account-kr');
      const en = document.getElementById('nav-account-en');
      const sideLink = document.getElementById('side-account-link');
      const loggedIn = !!sessionStorage.getItem('user_email');
      if (kr && en) {
        if (loggedIn) {
          kr.textContent = '로그아웃';
          en.textContent = 'Log Out';
        } else {
          kr.textContent = '회원가입/로그인';
          en.textContent = 'Sign Up / Log In';
        }
      }
      if (sideLink) sideLink.textContent = loggedIn ? '로그아웃' : '회원가입/로그인';
    });
  </script>

  <script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" defer></script>

  <!-- 이용권 만료 카운트다운 — 로그인 상태 확인 후 /api/entitlements 조회 -->
  <script type="module" define:vars={{ FIREBASE_API_KEY, FIREBASE_AUTH_DOMAIN, FIREBASE_PROJECT_ID, CHANNEL_LABELS, requireChannel }}>
    import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js';
    import { getAuth, onAuthStateChanged, signOut } from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js';

    const app = initializeApp({
      apiKey: FIREBASE_API_KEY,
      authDomain: FIREBASE_AUTH_DOMAIN,
      projectId: FIREBASE_PROJECT_ID,
    });
    const auth = getAuth(app);

    const bar = document.getElementById('entitlement-bar');
    const barInner = document.getElementById('entitlement-bar-inner');

    function daysLeft(expiresAt) {
      return Math.max(0, Math.ceil((expiresAt - Date.now()) / (24 * 60 * 60 * 1000)));
    }

    function renderBar(entitlements) {
      const entries = Object.values(entitlements || {}).filter((e) => e.expiresAt > Date.now());
      if (!entries.length) {
        bar.hidden = true;
        return;
      }
      entries.sort((a, b) => a.expiresAt - b.expiresAt);
      barInner.innerHTML = entries
        .map((e) => {
          const label = CHANNEL_LABELS[e.channel] || e.channel;
          const d = daysLeft(e.expiresAt);
          const urgent = d <= 7 ? ' entitlement-urgent' : '';
          return `<a href="/pricing" class="entitlement-chip${urgent}">${label} · D-${d}</a>`;
        })
        .join('');
      bar.hidden = false;
    }

    // 채널 접근권한 게이팅 — requireChannel이 지정된 페이지에서만 동작
    const mainEl = document.getElementById('main-content');
    const gateLoading = document.getElementById('channel-gate-loading');

    function unlockChannelPage() {
      if (gateLoading) gateLoading.remove();
      if (mainEl) mainEl.setAttribute('data-unlocked', '1');
    }

    function redirectToLogin() {
      const redirect = encodeURIComponent(window.location.pathname);
      window.location.href = `/01-auth?redirect=${redirect}`;
    }

    function redirectToPricing() {
      window.location.href = '/pricing';
    }

    // 이 브라우저/기기의 고정 식별자 (01-auth 로그인 시 생성된 것과 동일한 값)
    function getDeviceId() {
      let id = localStorage.getItem('tj_device_id');
      if (!id) {
        id = 'dev_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 10);
        localStorage.setItem('tj_device_id', id);
      }
      return id;
    }

    function redirectToDeviceLimit() {
      window.location.href = '/03-device-limit';
    }

    // 동시접속 초과로 다른 기기 로그인 시 이 기기가 밀려났는지(evicted) 확인.
    // 밀려났으면 강제 로그아웃 처리 후 안내 페이지로 이동.
    async function checkDeviceSession(user) {
      try {
        const token = await user.getIdToken();
        const res = await fetch(`/api/device-session?deviceId=${encodeURIComponent(getDeviceId())}`, {
          headers: { Authorization: `Bearer ${token}` },
        });
        if (!res.ok) return true;
        const data = await res.json();
        if (data.valid === false) {
          await signOut(auth);
          sessionStorage.removeItem('user_email');
          redirectToDeviceLimit();
          return false;
        }
        return true;
      } catch (e) {
        console.error('[device-session] check failed', e);
        return true;
      }
    }

    onAuthStateChanged(auth, async (user) => {
      if (!user) {
        bar.hidden = true;
        if (requireChannel) redirectToLogin();
        return;
      }

      const stillValid = await checkDeviceSession(user);
      if (!stillValid) return;

      try {
        const token = await user.getIdToken();
        const res = await fetch('/api/entitlements', {
          headers: { Authorization: `Bearer ${token}` },
        });
        if (!res.ok) {
          bar.hidden = true;
          if (requireChannel) redirectToPricing();
          return;
        }
        const data = await res.json();

        if (data.isAdmin) {
          bar.hidden = false;
          barInner.innerHTML = '<span class="entitlement-chip entitlement-admin">ADMIN · 전체 채널 무제한</span>';
          if (requireChannel) unlockChannelPage();
          return;
        }

        renderBar(data.entitlements);

        if (requireChannel) {
          const ent = (data.entitlements || {})[requireChannel];
          if (ent && ent.expiresAt > Date.now()) {
            unlockChannelPage();
          } else {
            redirectToPricing();
          }
        }
      } catch (e) {
        console.error('[entitlement-bar]', e);
        bar.hidden = true;
        if (requireChannel) redirectToPricing();
      }
    });

    // 채널 콘텐츠 열람 중에도 5분마다 다른 기기에 의해 밀려나지 않았는지 재확인
    if (requireChannel) {
      setInterval(() => {
        const user = auth.currentUser;
        if (user) checkDeviceSession(user);
      }, 5 * 60 * 1000);
    }
  </script>

  <style is:global>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    :root{
      --bg:#0A192F;--border:#5B0E1B;--ivory:#FBF9F4;--muted:#8b96a8;--dim:#5d6c82;--gold:#D4AF37;
      --f-display:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",Roboto,Helvetica,Arial,sans-serif;--f-body:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Roboto,Helvetica,Arial,sans-serif;
      --container: min(1200px, 92vw);
    }
    html,body{background:var(--bg);color:var(--ivory);font-family:var(--f-body);min-height:100vh;overflow-x:hidden;scroll-behavior:smooth}
    button{font:inherit}
    a{color:inherit}

    /* 한글(-kr)은 언어 선택과 무관하게 항상 고정 노출된다(절대값). 각 -kr 요소는 개별적으로
       notranslate + translate="no"가 적용되어 있어 구글 번역 대상에서 제외되므로, 이제
       -kr을 숨길 필요가 없다. 둘째 줄(-en)만 선택한 언어로 자유롭게 번역된다(가변값, 기본은 영문). */

    .splash{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;z-index:9999;transition:opacity .5s ease}
    .splash-brand{font-family:var(--f-display);font-weight:900;font-size:clamp(1.8rem,6vw,2.6rem);letter-spacing:.06em;animation:tj-splash-pulse 1.4s ease-in-out infinite}
    @keyframes tj-splash-pulse{0%,100%{opacity:1}50%{opacity:.55}}
    @media (prefers-reduced-motion: reduce){.splash-brand{animation:none}}

    .nav{position:fixed;top:0;left:0;right:0;z-index:200;transition:background .3s ease,border-color .3s ease}
    .nav-scrolled{background:rgba(10,25,47,.92);backdrop-filter:blur(10px);border-bottom:1px solid rgba(91,14,27,.4)}
    .nav-inner{width:var(--container);margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:16px 0}
    .nav-logo{font-family:var(--f-display);font-weight:900;font-size:clamp(1rem,3vw,1.15rem);letter-spacing:.05em;color:#B33A52;text-decoration:none}
    .hamburger{display:flex;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:6px}
    .hamburger span{display:block;width:22px;height:2px;background:var(--ivory)}
    .nav-right{display:flex;flex-direction:column;align-items:flex-end;gap:8px}
    .nav-account-btn{display:flex;flex-direction:column;align-items:center;gap:1px;text-decoration:none;background:rgba(91,14,27,.55);border:1px solid #8B1A2A;border-radius:8px;padding:6px 14px}
    .nav-account-btn:hover{background:rgba(91,14,27,.8)}
    .nav-account-kr{font-size:clamp(.78rem,2vw,.9rem);font-weight:700;color:var(--muted)}
    .nav-account-en{font-size:clamp(.78rem,2vw,.9rem);font-weight:600;color:var(--ivory)}

    .entitlement-bar{position:fixed;top:64px;left:0;right:0;z-index:190;background:rgba(212,175,55,.1);border-bottom:1px solid rgba(212,175,55,.28);backdrop-filter:blur(6px)}
    .entitlement-bar-inner{width:var(--container);margin:0 auto;padding:6px 0;display:flex;gap:8px;flex-wrap:wrap;overflow-x:auto}
    .entitlement-chip{flex:0 0 auto;text-decoration:none;font-size:.72rem;font-weight:700;color:var(--gold);border:1px solid rgba(212,175,55,.4);border-radius:100px;padding:4px 12px;white-space:nowrap;transition:background .2s}
    .entitlement-chip:hover{background:rgba(212,175,55,.12)}
    .entitlement-chip.entitlement-urgent{color:#F16B24;border-color:rgba(241,107,36,.5)}
    .entitlement-chip.entitlement-admin{color:var(--gold);border-color:var(--gold);font-weight:800;cursor:default}

    main[data-require-channel]:not([data-unlocked]){visibility:hidden}
    .channel-gate-loading{position:fixed;inset:0;z-index:150;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;background:var(--bg);animation:tj-fade-in .3s ease}
    .channel-gate-spinner{width:32px;height:32px;border:3px solid rgba(212,175,55,.2);border-top-color:var(--gold);border-right-color:var(--gold);border-radius:50%;animation:tj-spin .7s cubic-bezier(.5,0,.5,1) infinite}
    .channel-gate-kr{font-size:clamp(.82rem,2.1vw,.94rem);color:var(--muted);font-weight:600}
    .channel-gate-en{font-size:clamp(.82rem,2.1vw,.94rem);color:var(--ivory)}
    @keyframes tj-spin{to{transform:rotate(360deg)}}
    @keyframes tj-fade-in{from{opacity:0}to{opacity:1}}
    @media (prefers-reduced-motion: reduce){.channel-gate-spinner{animation-duration:1.4s}}

    .nav-right-top{position:relative;display:flex;align-items:center;gap:8px}
    .nav-back-btn{background:transparent;border:1px solid rgba(255,255,255,.18);color:var(--ivory);font-size:.9rem;line-height:1;padding:8px 11px;border-radius:6px;cursor:pointer;transition:background .2s}
