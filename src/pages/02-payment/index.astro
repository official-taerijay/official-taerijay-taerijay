      },
    };

    // 결제 완료 후 이동시킬 채널 페이지 매핑 (key 접두사 기준)
    const KEY_TO_CHANNEL_PATH = {
      protocol_basic: '/04-channels/protocol',
      protocol_standard: '/04-channels/protocol',
      protocol_pro: '/04-channels/protocol',
      mini_basic: '/04-channels/mini',
      mini_standard: '/04-channels/mini',
      mini_pro: '/04-channels/mini',
      daiso_basic: '/04-channels/daiso',
      daiso_standard: '/04-channels/daiso',
      daiso_pro: '/04-channels/daiso',
      olive_basic: '/04-channels/oliveyoung',
      olive_standard: '/04-channels/oliveyoung',
      olive_pro: '/04-channels/oliveyoung',
      emart_cvs_basic: '/04-channels/emart-convenience',
      emart_cvs_standard: '/04-channels/emart-convenience',
      emart_cvs_pro: '/04-channels/emart-convenience',
      protocol_mini: '/04-channels/protocol',
      daiso_olive: '/04-channels/daiso',
      total: '/',
    };

    // DOM 참조
    const params    = new URLSearchParams(window.location.search);
    const key       = params.get('key') || '';
    const product   = PRICE_MAP[key];
    const successRedirectPath = KEY_TO_CHANNEL_PATH[key] || '/';

    const payCard       = document.getElementById('payCard');
    const channelBar    = document.getElementById('channelBar');
    const productName   = document.getElementById('productName');
    const productTier   = document.getElementById('productTier');
    const priceAmountKrw = document.getElementById('priceAmountKrw');
    const benefitList   = document.getElementById('benefitList');
    const userRow       = document.getElementById('userRow');
    const userEmailShow = document.getElementById('userEmailShow');
    const payBtn        = document.getElementById('payBtn');
    const statusBox     = document.getElementById('statusBox');
    const invalidScreen = document.getElementById('invalidScreen');

    if (!product) {
      invalidScreen.classList.add('visible');
      payCard.classList.add('invalid');

    } else {
      // 상품 정보 렌더링
      document.documentElement.style.setProperty('--accent', product.accent);
      channelBar.style.background = product.accent;

      productName.textContent  = product.label;
      productTier.textContent  = product.tier;

      const USD_KRW = 1400;
      const krwAmount = Math.round(product.price * USD_KRW).toLocaleString('ko-KR');
      priceAmountKrw.textContent = `₩${krwAmount}`;

      const priceUsdRow = document.getElementById('priceUsdRow');
      if (priceUsdRow) {
        const usdText = product.price % 1 === 0 ? product.price.toString() : product.price.toFixed(2);
        priceUsdRow.textContent = `USD $${usdText} (환율 변동에 따라 실제 청구 금액과 다를 수 있음)`;
      }

      benefitList.innerHTML = product.benefits
        .map(b => `<li><div class="benefit-icon">✓</div><div class="benefit-text"><span class="benefit-kr notranslate" translate="no">${b.kr}</span><span class="benefit-en">${b.en}</span></div></li>`)
        .join('');

      // 상품 정보(혜택 목록 등)가 나중에 JS로 삽입되므로, 이미 다른 언어가 선택된 상태라면
      // 구글 번역 위젯이 이 새 콘텐츠를 놓치지 않도록 다시 한번 재적용
      if (window.__tjRetranslate) window.__tjRetranslate();

      // 로그인 상태 확인
      const userEmail = sessionStorage.getItem('user_email');

      if (!userEmail) {
        const returnUrl = encodeURIComponent(window.location.href);
        window.location.href = `/01-auth?redirect=${returnUrl}`;
      } else {
        userRow.style.display = 'flex';
        userEmailShow.textContent = userEmail;
        payBtn.disabled = false;
        payBtn.textContent = `Activate · $${product.price.toFixed(2)} USD`;
      }

      // Paddle 초기화 (SDK 로드 실패, 토큰 누락 등 방어)
      if (typeof Paddle === 'undefined') {
        statusBox.className = 'status-box err';
        statusBox.textContent = '⚠️ Paddle SDK failed to load. Check network/ad-blocker and refresh.';
        payBtn.disabled = true;
        return;
      }
      if (!window.__TJ_PADDLE__) {
        statusBox.className = 'status-box err';
        statusBox.textContent = '⚠️ Payment config missing (PUBLIC_PADDLE_VENDOR_TOKEN not set).';
        payBtn.disabled = true;
        return;
      }
      try {
        Paddle.Initialize({ token: window.__TJ_PADDLE__ });
      } catch (e) {
        statusBox.className = 'status-box err';
        statusBox.textContent = `⚠️ Paddle init error: ${e.message || e}`;
        payBtn.disabled = true;
        return;
      }

      // 결제 버튼
      payBtn.addEventListener('click', function () {
        payBtn.disabled = true;
        payBtn.innerHTML = '<div class="btn-spinner"></div>&nbsp; Opening checkout...';
        statusBox.className = 'status-box';

        const userEmail = sessionStorage.getItem('user_email');

        // 사이트에서 선택한 언어를 Paddle이 지원하는 결제창 언어코드로 변환
        const PADDLE_LOCALE_MAP = {
          ko: 'ko', en: 'en', ja: 'ja', de: 'de', es: 'es', fr: 'fr',
          it: 'it', nl: 'nl', sv: 'sv', no: 'no', da: 'da', pl: 'pl',
          pt: 'pt', ru: 'ru', ar: 'ar', tr: 'tr',
          'zh-CN': 'zh-Hans', zh: 'zh-Hans', 'zh-TW': 'zh-Hant', 'zh-HK': 'zh-Hant',
        };
        const savedLang = localStorage.getItem('taerijay_lang') || 'ko';
        const paddleLocale = PADDLE_LOCALE_MAP[savedLang] || 'en';

        try {
        Paddle.Checkout.open({
          items: [{ priceId: product.priceId, quantity: 1 }],
          customer: { email: userEmail || undefined },
          settings: {
            displayMode: 'overlay',
            theme: 'dark',
            locale: paddleLocale,
            successUrl: `${window.location.origin}${successRedirectPath}?payment=success`,
            frameTarget: 'self',
          },
          eventCallback: function (data) {
            if (data.name === 'checkout.completed') {
              statusBox.className = 'status-box ok';
              statusBox.textContent = '✓ Payment complete! Activating your access...';
              setTimeout(() => { window.location.href = successRedirectPath; }, 2000);

            } else if (data.name === 'checkout.closed') {
              payBtn.disabled = false;
              payBtn.textContent = `Activate · $${product.price.toFixed(2)} USD`;

            } else if (data.name === 'checkout.error') {
              statusBox.className = 'status-box err';
              statusBox.textContent = '⚠️ Checkout error. Please try again or contact support.';
              payBtn.disabled = false;
              payBtn.textContent = `Activate · $${product.price.toFixed(2)} USD`;
            }
          },
        });
        } catch (e) {
          console.error(e);
          statusBox.className = 'status-box err';
          statusBox.textContent = `⚠️ Checkout failed to open: ${e.message || e}`;
          payBtn.disabled = false;
          payBtn.textContent = `Activate · $${product.price.toFixed(2)} USD`;
        }
      });
    }

  });
  </script>

  <!-- 다른 페이지에서 선택한 언어를 결제 페이지에서도 즉시 이어서 적용 -->
  <div id="google_translate_element" style="display:none"></div>
  <script>
    document.querySelectorAll('[class*="-kr"]').forEach((el) => {
      el.classList.add('notranslate');
      el.setAttribute('translate', 'no');
    });

    function payTranslatePage(code) {
      if (code === 'ko') {
        const combo = document.querySelector('.goog-te-combo');
        if (combo) { combo.value = ''; combo.dispatchEvent(new Event('change')); }
        document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
        return;
      }
      const gCode = code === 'zh-HK' ? 'zh-TW' : code;
      const trySetCombo = (attempt) => {
        const combo = document.querySelector('.goog-te-combo');
        if (combo) {
          // 이미 같은 언어로 설정돼 있으면 change 이벤트가 안 붙을 수 있어,
          // 새로 삽입된 노드(혜택 목록 등)까지 다시 스캔하도록 한번 초기화 후 재적용
          if (combo.value === gCode) {
            combo.value = '';
            combo.dispatchEvent(new Event('change'));
            setTimeout(() => {
              combo.value = gCode;
              combo.dispatchEvent(new Event('change'));
            }, 60);
          } else {
            combo.value = gCode;
            combo.dispatchEvent(new Event('change'));
          }
        } else if (attempt < 20) {
          setTimeout(() => trySetCombo(attempt + 1), 250);
        }
      };
      trySetCombo(0);
    }

    // 결제 상품 정보(혜택 목록 등)가 JS로 늦게 삽입된 뒤에도 현재 선택된 언어를
    // 다시 적용해주는 헬퍼 — main 스크립트에서 benefitList 렌더링 직후 호출됨
    window.__tjRetranslate = function () {
      const saved = localStorage.getItem('taerijay_lang');
      if (saved && saved !== 'ko') payTranslatePage(saved);
    };

    window.googleTranslateElementInit = function () {
      new google.translate.TranslateElement({ pageLanguage: 'ko', autoDisplay: false }, 'google_translate_element');
      window.__tjRetranslate();
    };

    const payBackBtn = document.getElementById('pay-back-btn');
    if (payBackBtn) {
      payBackBtn.addEventListener('click', () => {
        if (window.history.length > 1) history.back();
        else window.location.href = '/';
      });
    }

    const payLangTrigger = document.getElementById('pay-lang-trigger');
    const payLangMenu = document.getElementById('pay-lang-menu');
    const payLangCurrent = document.getElementById('pay-lang-current');
    if (payLangTrigger) {
      payLangTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        payLangMenu.hidden = !payLangMenu.hidden;
      });
      document.querySelectorAll('.pay-lang-option').forEach((opt) => {
        opt.addEventListener('click', () => {
          payLangCurrent.textContent = opt.dataset.name;
          localStorage.setItem('taerijay_lang', opt.dataset.code);
          payLangMenu.hidden = true;
          payTranslatePage(opt.dataset.code);
        });
      });
      document.addEventListener('click', (e) => {
        if (!payLangMenu.hidden && !e.target.closest('.pay-lang-dropdown')) payLangMenu.hidden = true;
      });
      const saved = localStorage.getItem('taerijay_lang');
      if (saved) {
        const opt = document.querySelector(`.pay-lang-option[data-code="${saved}"]`);
        if (opt) payLangCurrent.textContent = opt.dataset.name;
      }
    }
  </script>
  <script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" defer></script>
