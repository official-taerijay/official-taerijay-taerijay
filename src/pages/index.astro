---
import Layout from '../layouts/Layout.astro';
import HeroSlider from '../components/HeroSlider.astro';

// 메인 화면 히어로 배너 — 실제 이미지는 img 필드에 추후 URL만 채워넣으면 자동 반영됨(현재는 준비중 플레이스홀더)
const mainHeroSlides = [
  { titleKr: '대한민국, 그 안의 진짜 이야기', titleEn: 'The Real Korea, Curated', dateLabel: 'TAERIJAY', img: '/images/channels/home/hero-1.png' },
  { titleKr: '6개 채널, 하나의 구독', titleEn: '6 Channels, One Subscription', dateLabel: 'ALL SERVICES', img: '/images/channels/home/hero-2.png' },
  { titleKr: '외국인 관광객을 위한 로컬 정보', titleEn: 'Local Info for Every Traveler', dateLabel: 'FOR YOU', img: '/images/channels/home/hero-3.png' },
];

// heroImg: true인 채널만 /images/channels/*.jpg를 배경으로 요청한다.
// 이미지 파일이 실제로 public/images/channels/에 업로드되기 전까지는 false로 두어
// 브라우저가 404를 요청하지 않도록 방지한다(그라디언트 배경은 CSS에서 항상 표시됨).
// 이미지를 추가하면 해당 채널의 heroImg만 true로 바꾸면 된다.
const channels = {
  entertainment: { slug: 'entertainment', color: '#00E5FF', free: true,  tag: 'K-ENTERTAINMENT', region: 'Seoul',    regionKr: '서울', heroImg: false },
  protocol:      { slug: 'protocol',      color: '#F16B24', free: false, tag: 'K-SURVIVAL',      region: 'Seorak',   regionKr: '설악', heroImg: false },
  mini:          { slug: 'mini',          color: '#e8e4dc', free: false, tag: 'K-TRAVEL',        region: 'Jeonju',   regionKr: '전주', heroImg: false },
  red:           { slug: 'red',           color: '#E1261C', free: false, tag: 'K-BEAUTY',        region: 'Gyeongju', regionKr: '경주', heroImg: false },
  green:         { slug: 'green',         color: '#6F8B2E', free: false, tag: 'K-BEAUTY',        region: 'Busan',    regionKr: '부산', heroImg: false },
  emartCvs:      { slug: 'mart-convenience', color: '#FFDD00', free: false, tag: '이마트×트레이더스×노브랜드×이마트24×CU×GS25×세븐일레븐', region: 'Jeju', regionKr: '제주', heroImg: false },
};
const USD_KRW = 1400;
const krw = (usd) => Math.round(usd * USD_KRW).toLocaleString('ko-KR');
const heroStyle = (color, slug, imgName) => `--c:${color}${imgName ? `;--hero-img:url('/images/channels/${imgName}.jpg')` : ''}`;
---
<Layout title="TAERIJAY">
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-slider-wrap">
      <HeroSlider slides={mainHeroSlides} color="#B33A52" durationMs={5000} />
    </div>
    <div class="hero-scrim"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">TAERIJAY REPUBLIC OF KOREA</p>
      <h1 class="hero-wordmark notranslate" translate="no">TAERIJAY</h1>
      <div class="hero-cta-row">
        <button class="btn-primary" onclick="document.getElementById('plans').scrollIntoView({behavior:'smooth'})">PRICING</button>
        <button class="btn-ghost" onclick="document.getElementById('channels').scrollIntoView({behavior:'smooth'})">CHANNELS</button>
      </div>
    </div>
  </section>

  <section class="channels-section" id="channels">

    <div class="channel-row" data-count="1">
      <a href={`/04-channels/${channels.entertainment.slug}`} class="service-card" style={heroStyle(channels.entertainment.color, channels.entertainment.slug, channels.entertainment.heroImg ? channels.entertainment.slug : null)}>
        <span class="service-status status-click">CLICK</span>
        <span class="service-name notranslate" translate="no">taerijay+entertainment</span>
        <span class="service-tag">{channels.entertainment.tag}</span>
      </a>
    </div>

    <div class="channel-row" data-count="2">
      <a href={`/04-channels/${channels.protocol.slug}`} class="service-card" style={heroStyle(channels.protocol.color, channels.protocol.slug, channels.protocol.heroImg ? channels.protocol.slug : null)}>
        <span class="service-status status-click">CLICK</span>
        <span class="service-name notranslate" translate="no">taerijay+protocol</span>
        <span class="service-tag">{channels.protocol.tag}</span>
      </a>
      <a href={`/04-channels/${channels.mini.slug}`} class="service-card" style={heroStyle(channels.mini.color, channels.mini.slug, channels.mini.heroImg ? channels.mini.slug : null)}>
        <span class="service-status status-click">CLICK</span>
        <span class="service-name notranslate" translate="no">taerijay+mini</span>
        <span class="service-tag">{channels.mini.tag}</span>
      </a>
    </div>

    <div class="channel-row" data-count="2">
      <a href={`/04-channels/${channels.red.slug}`} class="service-card" style={heroStyle(channels.red.color, channels.red.slug, channels.red.heroImg ? 'daiso' : null)}>
        <span class="service-status status-click">CLICK</span>
        <span class="service-name notranslate" translate="no">taerijay+red</span>
        <span class="service-tag">{channels.red.tag}</span>
      </a>
      <a href={`/04-channels/${channels.green.slug}`} class="service-card" style={heroStyle(channels.green.color, channels.green.slug, channels.green.heroImg ? 'oliveyoung' : null)}>
        <span class="service-status status-click">CLICK</span>
        <span class="service-name notranslate" translate="no">taerijay+green</span>
        <span class="service-tag">{channels.green.tag}</span>
      </a>
    </div>

    <div class="channel-row" data-count="1">
      <a href={`/04-channels/${channels.emartCvs.slug}`} class="service-card" style={heroStyle(channels.emartCvs.color, channels.emartCvs.slug, channels.emartCvs.heroImg ? 'emart' : null)}>
        <span class="service-status status-click">CLICK</span>
        <span class="service-name notranslate" translate="no">taerijay+mart+convenience</span>
        <span class="service-tag notranslate" translate="no">{channels.emartCvs.tag}</span>
      </a>
    </div>
  </section>

  <section class="plans-section" id="plans">
    <a href="/pricing" class="plans-eyebrow-link">
      <p class="plans-eyebrow-kr">요금 선택</p>
      <p class="plans-eyebrow-en" data-i18n="en">SELECT TIER</p>
    </a>

    <div class="plan-row">
      <span class="plan-row-label">
        <span class="plan-row-label-kr">싱글 요금제</span>
        <span class="plan-row-label-en" data-i18n="en">SINGLE</span>
      </span>
      <div class="plan-row-items plan-row-items-stack">
        <a href="/pricing" class="tier-chip" style="--tc:#FBF9F4">
          <span class="tier-chip-price">USD 19.99</span>
          <span class="tier-chip-krw">₩{krw(19.99)} 상당</span>
          <span class="tier-chip-en" data-i18n="en">BASIC</span>
        </a>
        <a href="/pricing" class="tier-chip" style="--tc:#22C55E">
          <span class="tier-chip-price">USD 29.99</span>
          <span class="tier-chip-krw">₩{krw(29.99)} 상당</span>
          <span class="tier-chip-en" data-i18n="en">STANDARD</span>
        </a>
        <a href="/pricing" class="tier-chip" style="--tc:#F16B24">
          <span class="tier-chip-price">USD 39.99</span>
          <span class="tier-chip-krw">₩{krw(39.99)} 상당</span>
          <span class="tier-chip-en" data-i18n="en">PRO</span>
        </a>
      </div>
    </div>

    <div class="plan-row">
      <span class="plan-row-label">
        <span class="plan-row-label-kr">더블 요금제</span>
        <span class="plan-row-label-en" data-i18n="en">DOUBLE</span>
      </span>
      <div class="plan-row-items">
        <a href="/02-payment?key=protocol_mini" class="plan-chip plan-chip-double" style="--tc:#2DD4BF">
          <span class="plan-chip-name-wrap">
            <span class="plan-chip-prefix notranslate" translate="no">taerijay+</span>
            <span class="plan-chip-combo">protocol × mini</span>
          </span>
          <span class="plan-chip-price-wrap">
            <span class="plan-chip-price">USD 34.99</span>
            <span class="plan-chip-krw">₩{krw(34.99)} 상당</span>
          </span>
        </a>
      </div>
    </div>

    <div class="plan-row">
      <span class="plan-row-label">
        <span class="plan-row-label-kr">더블 요금제</span>
        <span class="plan-row-label-en" data-i18n="en">DOUBLE</span>
      </span>
      <div class="plan-row-items">
        <a href="/02-payment?key=red_green" class="plan-chip plan-chip-double" style="--tc:#818CF8">
          <span class="plan-chip-name-wrap">
            <span class="plan-chip-prefix notranslate" translate="no">taerijay+</span>
            <span class="plan-chip-combo">red × green</span>
          </span>
          <span class="plan-chip-price-wrap">
            <span class="plan-chip-price">USD 34.99</span>
            <span class="plan-chip-krw">₩{krw(34.99)} 상당</span>
          </span>
        </a>
      </div>
    </div>

    <div class="plan-row plan-row-total">
      <span class="plan-row-label">
        <span class="plan-row-label-kr" style="color:#B33A52">토탈 요금제</span>
        <span class="plan-row-label-en" style="color:#B33A52" data-i18n="en">TOTAL</span>
      </span>
      <div class="plan-row-items">
        <a href="/02-payment?key=total" class="plan-chip plan-chip-gold" style="--tc:#B33A52">
          <div class="plan-chip-total-list">
            <span class="plan-chip-name">ALL SERVICES</span>
            <span class="plan-chip-total-item notranslate" translate="no">taerijay+protocol</span>
            <span class="plan-chip-total-item notranslate" translate="no">taerijay+mini</span>
            <span class="plan-chip-total-item notranslate" translate="no">taerijay+red</span>
            <span class="plan-chip-total-item notranslate" translate="no">taerijay+green</span>
            <span class="plan-chip-total-item notranslate" translate="no">taerijay+mart+convenience</span>
          </div>
          <span class="plan-chip-price-wrap">
            <span class="plan-chip-price">USD 99.99</span>
            <span class="plan-chip-krw">₩{krw(99.99)} 상당</span>
          </span>
        </a>
      </div>
    </div>

    <div class="plans-more">
      <a href="/pricing" class="btn-plans-more">
        <span class="btn-plans-more-kr">요금제 자세히 보기</span>
        <span class="btn-plans-more-en" data-i18n="en">View Full Pricing →</span>
      </a>
    </div>
  </section>

  <style>
    .hero{position:relative;min-height:78vh;min-height:78dvh;display:flex;align-items:center;overflow:hidden}
    .hero-bg{
      position:absolute;inset:0;
      background:
        radial-gradient(ellipse 90% 60% at 15% 20%, rgba(91,14,27,.55) 0%, transparent 60%),
        radial-gradient(ellipse 70% 50% at 85% 80%, rgba(212,175,55,.12) 0%, transparent 55%),
        linear-gradient(160deg, #0d1f3d 0%, #0A192F 55%, #060f1e 100%);
    }
    .hero-scrim{position:absolute;inset:0;background:linear-gradient(180deg, rgba(10,25,47,.2) 0%, rgba(10,25,47,.4) 55%, var(--bg) 100%);z-index:1}
    .hero-slider-wrap{position:absolute;inset:0;z-index:0}
    .hero-slider-wrap :global(.hero-slider){width:100%;height:100%;aspect-ratio:auto;border-radius:0;border:none;box-shadow:none;margin-bottom:0}
    .hero-slider-wrap :global(.hero-slider-info),
    .hero-slider-wrap :global(.hero-slider-track),
    .hero-slider-wrap :global(.hero-slide-placeholder-kr),
    .hero-slider-wrap :global(.hero-slide-placeholder-en){display:none}
    .hero-slider-wrap :global(.hero-slide-placeholder svg){opacity:.35}
    .hero-content{position:relative;z-index:2;width:var(--container);margin:0 auto;text-align:left}
    .hero-eyebrow{font-size:clamp(.8rem,2vw,1rem);letter-spacing:.22em;font-weight:700;color:var(--gold);margin-bottom:20px}
    .hero-wordmark{
      font-family:var(--f-display);font-weight:900;
      font-size:clamp(3rem,14vw,9rem);
      letter-spacing:.02em;line-height:1;
      background:linear-gradient(120deg, var(--ivory) 0%, var(--ivory) 55%, #B33A52 100%);
      -webkit-background-clip:text;background-clip:text;color:transparent;
      margin-bottom:36px;
    }
    .hero-cta-row{display:flex;gap:12px;flex-wrap:wrap}
    .btn-primary{background:var(--ivory);color:var(--bg);border:none;border-radius:8px;padding:14px 28px;font-weight:700;font-size:.85rem;letter-spacing:.05em;cursor:pointer;transition:transform .15s,box-shadow .2s}
    .btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(0,0,0,.35)}
    .btn-ghost{background:rgba(255,255,255,.08);color:var(--ivory);border:1px solid rgba(255,255,255,.25);border-radius:8px;padding:14px 28px;font-weight:700;font-size:.85rem;letter-spacing:.05em;cursor:pointer;transition:background .2s}
    .btn-ghost:hover{background:rgba(255,255,255,.16)}

    .channels-section{width:var(--container);margin:0 auto;padding:56px 0 20px}
    .channel-row{display:grid;gap:16px;margin-bottom:16px}
    .channel-row[data-count="1"]{grid-template-columns:1fr}
    .channel-row[data-count="2"]{grid-template-columns:1fr 1fr}

    .service-card{
      position:relative;display:flex;flex-direction:column;gap:6px;text-decoration:none;
      padding:24px 22px;border-radius:14px;overflow:hidden;min-height:150px;
      border:1px solid color-mix(in srgb, var(--c) 45%, transparent);
      background-image:var(--hero-img, none),
        radial-gradient(ellipse 90% 100% at 15% 0%, color-mix(in srgb, var(--c) 20%, transparent) 0%, transparent 55%),
        linear-gradient(160deg, color-mix(in srgb, var(--c) 14%, var(--bg)) 0%, var(--bg) 88%);
      background-size:cover;background-position:center;
      transition:transform .28s cubic-bezier(.2,.8,.2,1), box-shadow .28s ease, border-color .28s ease;
      will-change:transform;
    }
    .service-card::before{content:'';position:absolute;inset:0;background:linear-gradient(180deg, rgba(6,10,18,.15) 0%, rgba(6,10,18,.88) 100%);z-index:0;transition:background .28s ease}
    .service-card:hover{
      transform:translateY(-5px) scale(1.015);
      border-color:color-mix(in srgb, var(--c) 70%, transparent);
      box-shadow:0 22px 48px -18px color-mix(in srgb, var(--c) 50%, transparent), 0 6px 16px rgba(0,0,0,.4);
      z-index:2;
    }
    .service-card:focus-visible{outline:2px solid var(--c);outline-offset:2px}
    .service-card > *{position:relative;z-index:1}
    @media (prefers-reduced-motion: reduce){
      .service-card{transition:none}
      .service-card:hover{transform:none}
    }
    .service-status{align-self:flex-end;flex:0 0 auto;margin-bottom:auto;font-size:.62rem;font-weight:800;letter-spacing:.08em;padding:3px 10px;border-radius:100px}
    .status-click{background:var(--gold);color:var(--bg)}
    .service-region{font-size:.72rem;font-weight:700;letter-spacing:.1em;color:var(--c);text-transform:uppercase;margin-top:12px}
    .service-name{font-family:var(--f-display);font-weight:700;font-size:clamp(1.5rem,4.2vw,2.1rem);line-height:1.15;color:var(--c)}
    .service-tag{font-size:.92rem;font-weight:700;color:var(--muted);letter-spacing:.02em}

    .plans-section{width:var(--container);margin:0 auto;padding:60px 0 90px}
    .plans-eyebrow-kr{font-size:clamp(.78rem,2vw,.94rem);font-weight:700;color:var(--muted);margin-bottom:2px}
    .plans-eyebrow-en{font-size:clamp(.78rem,2vw,.94rem);letter-spacing:.06em;font-weight:700;color:var(--muted);margin-bottom:28px;text-transform:uppercase}
    .plans-eyebrow-link{text-decoration:none;display:inline-block;cursor:pointer}
    .plans-eyebrow-link:hover .plans-eyebrow-en{color:var(--gold)}
    .plans-more{text-align:left;margin-top:32px}
    .btn-plans-more{display:inline-flex;flex-direction:column;align-items:flex-start;gap:2px;text-decoration:none;border:1px solid rgba(212,175,55,.4);border-radius:100px;padding:12px 28px;transition:background .2s}
    .btn-plans-more:hover{background:rgba(212,175,55,.1)}
    .btn-plans-more-kr{font-size:clamp(.86rem,2.2vw,1rem);font-weight:700;color:var(--ivory)}
    .btn-plans-more-en{font-size:clamp(.86rem,2.2vw,1rem);font-weight:600;color:var(--gold)}

    .plan-row{display:flex;align-items:center;gap:18px;padding:16px 0;border-bottom:1px solid rgba(255,255,255,.08);flex-wrap:wrap}
    .plan-row-total{border-bottom:none}
    .plan-row-label{flex:0 0 110px;display:flex;flex-direction:column;gap:2px}
    .plan-row-label-kr{font-size:clamp(.78rem,2vw,.9rem);font-weight:700;color:var(--muted)}
    .plan-row-label-en{font-size:clamp(.78rem,2vw,.9rem);font-weight:600;letter-spacing:.05em;color:var(--dim);text-transform:uppercase}
    .plan-row-items{display:flex;gap:12px;flex-wrap:wrap;flex:1}

    .plan-row-items-stack{flex-direction:column;gap:10px}
    .tier-chip{text-decoration:none;cursor:pointer;border:2px solid var(--tc, var(--gold));border-radius:10px;padding:12px 18px;display:flex;flex-direction:column;gap:2px;width:100%;background:color-mix(in srgb, var(--tc, var(--gold)) 10%, transparent);transition:background .2s,transform .15s}
    .tier-chip:hover{background:color-mix(in srgb, var(--tc, var(--gold)) 20%, transparent);transform:translateY(-1px)}
    .tier-chip-price{font-family:var(--f-display);font-weight:900;font-size:1.15rem;color:var(--tc, var(--gold));display:block}
    .tier-chip-krw{display:block;font-size:.7rem;font-weight:600;color:var(--dim);margin-top:1px}
    .tier-chip-en{font-size:.78rem;font-weight:700;letter-spacing:.06em;color:var(--tc, var(--gold));text-transform:uppercase}

    .plan-chip{text-decoration:none;cursor:pointer;color:inherit;border:2px solid var(--tc, rgba(91,14,27,.4));border-radius:10px;padding:12px 18px;display:flex;flex-direction:column;gap:2px;width:100%;min-width:150px;flex:1;background:color-mix(in srgb, var(--tc, transparent) 10%, transparent);transition:background .2s,transform .15s}
    .plan-chip:hover{background:color-mix(in srgb, var(--tc, transparent) 20%, transparent);transform:translateY(-1px)}
    .plan-chip-double{flex-direction:row;align-items:center;justify-content:space-between;gap:16px;flex:1 1 100%;flex-wrap:wrap}
    .plan-chip-gold{flex-direction:column;align-items:flex-start;gap:14px;flex:1 1 100%;padding:18px}
    .plan-chip-name{font-family:var(--f-display);font-weight:700;font-size:.88rem;color:var(--ivory)}
    .plan-chip-name-wrap{display:flex;flex-direction:column;gap:2px}
    .plan-chip-prefix{font-size:.7rem;font-weight:700;color:var(--dim);letter-spacing:.03em}
    .plan-chip-combo{font-family:var(--f-display);font-weight:700;font-size:1.05rem;color:var(--ivory)}
    .plan-chip-price-wrap{display:flex;flex-direction:column;align-items:flex-end;gap:0}
    .plan-chip-price{font-family:var(--f-display);font-weight:900;font-size:1.3rem;color:var(--tc, var(--gold))}
    .plan-chip-krw{font-size:.72rem;font-weight:600;color:var(--dim)}
    .plan-chip-total-list{display:flex;flex-direction:column;gap:5px}
    .plan-chip-total-item{font-family:var(--f-body);font-weight:600;font-size:.8rem;letter-spacing:.02em;color:var(--muted)}

    @media (max-width: 900px){
      .hero-wordmark{font-size:clamp(2.6rem,13vw,5rem)}
    }
    @media (max-width: 560px){
      .channel-row[data-count="2"]{grid-template-columns:1fr}
      .plan-row{flex-direction:column;align-items:flex-start}
      .plan-row-label{flex:none}
      .plan-chip-double{flex-direction:column;align-items:flex-start;gap:6px}
      .hero{min-height:70vh;min-height:70dvh}
    }
    @media (max-width: 340px){
      .hero-wordmark{font-size:2.2rem;word-break:break-word}
    }
  </style>
</Layout>