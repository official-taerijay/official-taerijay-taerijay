---
// 이 페이지는 더 이상 정적 빌드되지 않고, 요청 시점에 구글시트에서 콘텐츠를 읽어온다.
// 구글시트에서 행을 추가/수정/삭제하면 재배포 없이 바로 반영됨 (최대 60초 캐시).
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { CHANNEL_MAP } from '../../../lib/channelCategories.js';
import { fetchChannelRows } from '../../../lib/sheetsCms.js';
import '../../../styles/channel-page.css';

const { channel, sub } = Astro.params;
const channelData = CHANNEL_MAP[channel];
const subData = channelData?.subs?.[sub];

if (!channelData || !subData) {
  return Astro.redirect('/04-channels', 302);
}

const color = channelData.color;
// entertainment 채널 전체 + 각 채널의 free:true 카테고리는 로그인/이용권 확인 없이 열람 가능
// freeCount가 있는 카테고리(예: 브랜드별 TOP 30)는 페이지 자체는 열려있고, 앞쪽 N개만 무료로 노출
const requireChannel = (channel === 'entertainment' || subData.free || subData.freeCount) ? '' : channel;
const freeCount = subData.freeCount || 0;

let items = [];
let loadError = false;
try {
  const allRows = await fetchChannelRows(channel);
  items = allRows.filter((r) => (r.sub || '').trim() === sub);
} catch (e) {
  console.error('[sub-page] sheet fetch failed', e);
  loadError = true;
}

const lockedCount = freeCount > 0 ? Math.max(items.length - freeCount, 0) : 0;
const visibleItems = freeCount > 0 ? items.slice(0, freeCount) : items;
const lockedItems = freeCount > 0 ? items.slice(freeCount) : [];

// tips_kr/tips_en처럼 "▪ 항목1 ▪ 항목2 ▪ 항목3" 형태로 한 줄에 이어진 텍스트를
// 항목별로 쪼개서 각각 줄바꿈해 보여주기 위한 헬퍼. ▪ 구분자가 없으면 원문 한 줄 그대로 반환.
function splitBullets(text) {
  if (!text) return [];
  const parts = text.split('▪').map((s) => s.trim()).filter(Boolean);
  return parts.length > 1 ? parts : [text.trim()];
}

// addr_kr에서 "서울/부산/제주 ..." 같은 시/도 단위를 최대한 추출.
// item.region이 있으면 그걸 우선 쓰고, 없으면 주소 앞부분에서 시/도명을 뽑아온다.
const SIDO_LIST = ['서울', '부산', '대구', '인천', '광주', '대전', '울산', '세종', '경기', '강원', '충북', '충남', '전북', '전남', '경북', '경남', '제주'];
function extractSido(item) {
  if (item.region) return item.region.split(/[·,\s]/)[0];
  const addr = item.addr_kr || '';
  const found = SIDO_LIST.find((s) => addr.startsWith(s) || addr.includes(s));
  return found || '';
}
---
<Layout title={`taerijay+${channel} · ${subData.kr} | TAERIJAY`} requireChannel={requireChannel}>
  <div class="sub-page" style={`--c:${color}`}>
    <div class="sub-topbar">
      <button type="button" class="back-btn" onclick="history.back()">← 뒤로가기</button>
    </div>

    <section class="sub-hero">
      <a href={`/04-channels/${channel}`} class="sub-parent-link">taerijay+{channel}</a>
      <h1 class="sub-title">
        <span class="sub-title-kr">{subData.kr}</span>
        <span class="sub-title-en" data-i18n="en">{subData.en}</span>
      </h1>
    </section>

    {loadError && (
      <section class="empty-note">
        <p>콘텐츠를 불러오지 못했습니다. 잠시 후 다시 시도해주세요.</p>
        <p class="empty-note-en">Failed to load content. Please try again shortly.</p>
      </section>
    )}

    {!loadError && items.length === 0 && (
      <section class="empty-note">
        <p>콘텐츠 준비 중입니다.</p>
        <p class="empty-note-en">Content coming soon.</p>
      </section>
    )}

    {!loadError && items.length > 0 && (
      <section class="item-list">
        <p class="content-notice notranslate" translate="no">
          💡 본 콘텐츠는 AI 도구를 활용해 정리되었으며, 순차적으로 웹검색 팩트체크를 진행 중입니다. 실제 방문 전 최신 정보를 별도로 확인해 주세요.
          <span class="content-notice-en">Some content is AI-assisted and undergoing fact-check verification. Please confirm details before visiting.</span>
        </p>
        {items.map((item, idx) => {
          const isLocked = freeCount > 0 && idx >= freeCount;
          return (
          <article class={`item-card${isLocked ? ' item-card-locked' : ''}`} data-locked-item={isLocked ? '1' : undefined} hidden={isLocked || undefined}>
            <div class="item-card-head">
              <p class="item-locname notranslate" translate="no">
                {extractSido(item) && <span class="item-locname-region">[{extractSido(item)}]</span>}
                <span class="item-locname-sep">|</span>
                <span class="item-locname-title">[{item.title_kr}]</span>
              </p>
              <h2 class="item-title-kr notranslate" translate="no">{item.title_kr}</h2>
              {item.title_en && <p class="item-title-en">{item.title_en}</p>}
            </div>

            {(item.region) && (
              <span class="item-tag notranslate" translate="no">{item.region}</span>
            )}
            {(item.platform) && (
              <span class="item-tag notranslate" translate="no">{item.platform}</span>
            )}
            {(item.brand_kr) && (
              <span class="item-tag notranslate" translate="no">{item.brand_kr}</span>
            )}

            {(item.desc_kr) && (
              <p class="item-desc-kr notranslate" translate="no">{item.desc_kr}</p>
            )}
            {(item.desc_en) && <p class="item-desc-en">{item.desc_en}</p>}

            <div class="item-meta">
              {item.addr_kr && (
                <div class="item-meta-row item-meta-row-addr">
                  <span class="item-meta-label">주소</span>
                  <span class="item-meta-value item-addr-value notranslate" translate="no">{item.addr_kr}</span>
                  <button
                    type="button"
                    class="addr-copy-btn"
                    data-copy-text={item.addr_kr}
                    aria-label="주소 복사"
                    title="주소 복사 Copy address"
                  >
                    <svg class="addr-copy-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <rect x="7" y="7" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M13 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                    <span class="addr-copy-label">복사</span>
                  </button>
                </div>
              )}
              {item.phone_kr && (
                <div class="item-meta-row item-meta-row-phone">
                  <span class="item-meta-label">연락처</span>
                  <span class="item-meta-value item-phone-value notranslate" translate="no">{item.phone_kr}</span>
                  <a
                    href={`tel:${item.phone_kr.replace(/[^0-9+]/g, '')}`}
                    class="phone-call-btn"
                    aria-label="전화 걸기"
                    title="전화 걸기 Call"
                  >
                    <svg class="phone-call-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M6 2.5c.5 0 .9.3 1 .8l.6 2.4c.1.4 0 .9-.3 1.2l-1 1c.8 1.7 2.2 3.1 3.9 3.9l1-1c.3-.3.8-.4 1.2-.3l2.4.6c.5.1.8.5.8 1v2c0 .6-.4 1-1 1C8.9 15.1 4.9 11.1 4.5 5c0-.6.4-1 1-1H6Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                    </svg>
                    <span class="phone-call-label">전화</span>
                  </a>
                </div>
              )}
              {item.hours_kr && (
                <div class="item-meta-row">
                  <span class="item-meta-label">시간</span>
                  <span class="item-meta-value notranslate" translate="no">{item.hours_kr}</span>
                </div>
              )}
              {item.route_kr && (
                <div class="item-meta-row">
                  <span class="item-meta-label">동선</span>
                  <span class="item-meta-value notranslate" translate="no">{item.route_kr}</span>
                </div>
              )}
              {item.duration && (
                <div class="item-meta-row">
                  <span class="item-meta-label">소요시간</span>
                  <span class="item-meta-value notranslate" translate="no">{item.duration}</span>
                </div>
              )}
              {item.budget_kr && (
                <div class="item-meta-row">
                  <span class="item-meta-label">예산</span>
                  <span class="item-meta-value notranslate" translate="no">{item.budget_kr}</span>
                </div>
              )}
              {item.price_kr && (
                <div class="item-meta-row">
                  <span class="item-meta-label">가격대</span>
                  <span class="item-meta-value notranslate" translate="no">{item.price_kr}</span>
                </div>
              )}
              {item.genre && (
                <div class="item-meta-row">
                  <span class="item-meta-label">장르</span>
                  <span class="item-meta-value notranslate" translate="no">{item.genre}{item.year ? ` · ${item.year}` : ''}</span>
                </div>
              )}
              {item.cast_kr && (
                <div class="item-meta-row">
                  <span class="item-meta-label">출연</span>
                  <span class="item-meta-value notranslate" translate="no">{item.cast_kr}</span>
                </div>
              )}
            </div>

            {item.tips_kr && (
              <div class="item-tips">
                <p class="item-tips-label">💡 팁 <span class="item-tips-label-en">Tips</span></p>
                <ul class="item-tips-list">
                  {splitBullets(item.tips_kr).map((line, i) => (
                    <li class="item-tips-line">
                      <span class="item-tips-kr notranslate" translate="no">{line}</span>
                      {splitBullets(item.tips_en)[i] && (
                        <span class="item-tips-en">{splitBullets(item.tips_en)[i]}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <div class="item-links">
              {item.naver_map && <a href={item.naver_map} target="_blank" rel="noopener noreferrer" class="item-link-btn">네이버지도</a>}
              {item.kakao_map && <a href={item.kakao_map} target="_blank" rel="noopener noreferrer" class="item-link-btn">카카오맵</a>}
              {item.web && <a href={item.web} target="_blank" rel="noopener noreferrer" class="item-link-btn item-link-btn-web">공식 웹사이트</a>}
            </div>
          </article>
          );
        })}

        {lockedCount > 0 && (
          <div class="locked-teaser" id="locked-teaser" data-require-channel={channel}>
            <div class="locked-teaser-inner">
              <p class="locked-teaser-title">🔒 나머지 {lockedCount}개는 구독 후 확인 가능</p>
              <p class="locked-teaser-title-en">{lockedCount} more items available with a subscription</p>
              <a href="/pricing" class="channel-subscribe-btn locked-teaser-btn">구독하기 · Subscribe</a>
            </div>
            <ul class="locked-teaser-list" aria-hidden="true">
              {lockedItems.slice(0, 6).map((item) => (
                <li class="locked-teaser-item notranslate" translate="no">{item.title_kr}</li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )}
  </div>

  <script>
    // 주소 복사 버튼: 클릭 시 클립보드에 주소 텍스트를 복사하고 잠깐 "복사됨" 피드백 표시
    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('.addr-copy-btn');
      if (!btn) return;
      const text = btn.getAttribute('data-copy-text') || '';
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch (err) {
        // 클립보드 API가 막힌 환경(비-https 등) 대비 폴백
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const label = btn.querySelector('.addr-copy-label');
      const originalText = label ? label.textContent : '';
      btn.classList.add('addr-copy-btn-done');
      if (label) label.textContent = '복사됨';
      setTimeout(() => {
        btn.classList.remove('addr-copy-btn-done');
        if (label) label.textContent = originalText;
      }, 1500);
    });
  </script>

  <script type="module">
    // freeCount 기반 부분 잠금 페이지 전용: ADMIN 또는 해당 채널 이용권 보유자라면
    // 서버가 hidden 처리해둔 잠긴 카드를 노출하고 구독 유도 배너를 숨긴다.
    const teaser = document.getElementById('locked-teaser');
    if (teaser) {
      const requireChannel = teaser.getAttribute('data-require-channel') || '';
      // entitlements 문서는 emart-convenience를 'emart'/'convenience' 두 키로 나눠 저장하므로 매핑 필요
      const ENTITLEMENT_KEY_MAP = { 'emart-convenience': 'emart' };
      const entKey = ENTITLEMENT_KEY_MAP[requireChannel] || requireChannel;

      const unlockLockedItems = () => {
        document.querySelectorAll('[data-locked-item="1"]').forEach((el) => {
          el.hidden = false;
        });
        teaser.hidden = true;
      };

      import('https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js').then(({ initializeApp }) => {
        import('https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js').then(async ({ getAuth, onAuthStateChanged }) => {
          const app = initializeApp({
            apiKey: 'AIzaSyDohULKEyCcSi30UpbLJSwPwHJ0Vad8J5M',
            authDomain: 'taerijay-official.firebaseapp.com',
            projectId: 'taerijay-official',
          });
          const auth = getAuth(app);
          onAuthStateChanged(auth, async (user) => {
            if (!user) return;
            try {
              const token = await user.getIdToken();
              const res = await fetch('/api/entitlements', { headers: { Authorization: `Bearer ${token}` } });
              if (!res.ok) return;
              const data = await res.json();
              if (data.isAdmin) {
                unlockLockedItems();
                return;
              }
              const ent = (data.entitlements || {})[entKey];
              if (ent && ent.expiresAt > Date.now()) {
                unlockLockedItems();
              }
            } catch (e) {
              console.error('[locked-teaser] entitlement check failed', e);
            }
          });
        });
      });
    }
  </script>

  <style>
    .item-list{display:flex;flex-direction:column;gap:20px;margin-bottom:40px}
    .content-notice{font-size:.76rem;color:var(--dim);line-height:1.6;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:10px 14px;margin-bottom:4px}
    .content-notice-en{display:block;margin-top:2px;color:var(--dim);opacity:.8}
    .item-card{
      border:1px solid color-mix(in srgb, var(--c) 30%, transparent);border-radius:16px;padding:22px 24px;
      background:linear-gradient(160deg, color-mix(in srgb, var(--c) 6%, var(--bg)) 0%, var(--bg) 60%);
      transition:border-color .2s ease, box-shadow .2s ease;
    }
    .item-card:hover{border-color:color-mix(in srgb, var(--c) 55%, transparent);box-shadow:0 12px 30px -14px color-mix(in srgb, var(--c) 40%, transparent)}
    .item-card-head{margin-bottom:8px}
    .item-locname{display:flex;align-items:center;gap:8px;font-size:.76rem;font-weight:700;color:var(--c);margin-bottom:6px;word-break:keep-all}
    .item-locname-sep{color:var(--dim);opacity:.5}
    .item-locname-title{color:var(--gold)}
    .item-title-kr{font-family:var(--f-display);font-weight:800;font-size:clamp(1.05rem,3vw,1.3rem);color:var(--ivory);word-break:keep-all}
    .item-title-en{font-size:.78rem;letter-spacing:.04em;color:var(--muted);text-transform:uppercase;margin-top:2px}
    .item-tag{display:inline-block;font-size:.68rem;font-weight:700;color:var(--c);background:color-mix(in srgb, var(--c) 16%, transparent);border:1px solid color-mix(in srgb, var(--c) 40%, transparent);border-radius:100px;padding:3px 10px;margin-bottom:10px}
    .item-desc-kr{font-size:.86rem;color:var(--ivory);line-height:1.65;margin-top:8px;white-space:pre-line;word-break:keep-all}
    .item-desc-en{font-size:.8rem;color:var(--muted);line-height:1.6;margin-top:4px;white-space:pre-line}
    .item-meta{display:flex;flex-direction:column;gap:6px;margin-top:14px;padding-top:14px;border-top:1px solid rgba(255,255,255,.08)}
    .item-meta-row{display:flex;gap:10px;font-size:.82rem}
    .item-meta-row-addr{align-items:flex-start}
    .item-meta-label{flex:0 0 56px;color:var(--dim);font-weight:700;padding-top:2px}
    .item-meta-value{color:var(--muted);word-break:keep-all}
    .item-addr-value{flex:1}
    .addr-copy-btn{
      flex:0 0 auto;display:inline-flex;align-items:center;gap:4px;
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);border-radius:100px;
      padding:3px 10px;font-size:.7rem;font-weight:700;color:var(--ivory);cursor:pointer;
      transition:background .2s ease, border-color .2s ease, color .2s ease;
    }
    .addr-copy-btn:hover{background:rgba(255,255,255,.14)}
    .addr-copy-icon{width:12px;height:12px;flex:0 0 auto}
    .addr-copy-btn-done{background:color-mix(in srgb, var(--c) 30%, transparent);border-color:var(--c);color:var(--c)}
    .item-meta-row-phone{align-items:center}
    .item-phone-value{flex:1;font-weight:700;color:var(--ivory)}
    .phone-call-btn{
      flex:0 0 auto;display:inline-flex;align-items:center;gap:4px;text-decoration:none;
      background:color-mix(in srgb, var(--c) 18%, transparent);border:1px solid color-mix(in srgb, var(--c) 45%, transparent);border-radius:100px;
      padding:3px 10px;font-size:.7rem;font-weight:700;color:var(--c);cursor:pointer;
      transition:background .2s ease, border-color .2s ease;
    }
    .phone-call-btn:hover{background:color-mix(in srgb, var(--c) 30%, transparent)}
    .phone-call-icon{width:12px;height:12px;flex:0 0 auto}
    .item-tips{margin-top:14px}
    .item-tips-label{font-size:.72rem;font-weight:800;color:var(--gold);text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px}
    .item-tips-label-en{font-weight:600;color:var(--dim);text-transform:none;letter-spacing:0}
    .item-tips-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
    .item-tips-line{display:flex;flex-direction:column;gap:2px;padding:8px 12px;border-radius:10px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06)}
    .item-tips-kr{font-size:.84rem;line-height:1.6;color:var(--gold);word-break:keep-all}
    .item-tips-en{font-size:.78rem;line-height:1.55;color:var(--dim);word-break:break-word}
    .item-links{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}
    .item-link-btn{text-decoration:none;font-size:.76rem;font-weight:700;color:var(--ivory);background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);border-radius:100px;padding:6px 14px;transition:background .2s ease}
    .item-link-btn:hover{background:rgba(255,255,255,.14)}
    .item-link-btn-web{border-color:color-mix(in srgb, var(--c) 45%, transparent);color:var(--c)}
    .locked-teaser{position:relative;border:1px dashed color-mix(in srgb, var(--c) 45%, transparent);border-radius:16px;padding:26px 24px;overflow:hidden;background:linear-gradient(160deg, color-mix(in srgb, var(--c) 5%, var(--bg)) 0%, var(--bg) 70%)}
    .locked-teaser-inner{position:relative;z-index:2;text-align:center;display:flex;flex-direction:column;align-items:center;gap:6px}
    .locked-teaser-title{font-weight:800;font-size:.95rem;color:var(--ivory)}
    .locked-teaser-title-en{font-size:.76rem;color:var(--dim)}
    .locked-teaser-btn{margin-top:10px}
    .locked-teaser-list{list-style:none;margin:18px 0 0;padding:0;display:flex;flex-direction:column;gap:8px;filter:blur(5px);opacity:.5;user-select:none;pointer-events:none}
    .locked-teaser-item{font-size:.84rem;color:var(--muted);padding:10px 14px;border:1px solid rgba(255,255,255,.08);border-radius:10px}
  </style>
</Layout>
