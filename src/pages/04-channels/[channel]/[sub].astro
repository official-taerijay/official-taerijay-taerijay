---
// 카테고리 안의 "항목 카드 그리드" 페이지 (넷플릭스 스타일 3단 구조의 2단계).
// 흐름: 채널 인덱스 → 카테고리(cat-card) → 이 페이지(item-card 그리드) → [item].astro(6섹션 상세)
// 구글시트에서 행을 추가/수정/삭제하면 재배포 없이 바로 반영됨 (최대 60초 캐시).
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { CHANNEL_MAP, mergeSheetCategories } from '../../../lib/channelCategories.js';
import { fetchChannelRows, deriveCategoriesFromRows, toStr } from '../../../lib/sheetsCms.js';
import { withItemSlugs, extractSido } from '../../../lib/itemHelpers.js';
import '../../../styles/channel-page.css';

const { channel, sub } = Astro.params;

let allRows = [];
let rawItems = [];
let loadError = false;
try {
  allRows = await fetchChannelRows(channel);
  rawItems = allRows.filter((r) => toStr(r.sub) === sub);
} catch (e) {
  console.error('[sub-index] sheet fetch failed', e);
  loadError = true;
}

// 시트의 sub_kr/sub_en/sub_free 컬럼으로 카테고리 메타(이름/무료여부)를 자동 인식.
// 시트에 없는 카테고리는 channelCategories.js의 기존 정의를 그대로 사용(하위호환).
// 카테고리 도출 로직이 예기치 않은 데이터로 실패해도 하드코딩된 CHANNEL_MAP으로 폴백해
// 페이지 전체가 500 에러로 죽지 않도록 방어.
let sheetCategories = [];
try {
  sheetCategories = deriveCategoriesFromRows(allRows);
} catch (e) {
  console.error('[sub-index] deriveCategoriesFromRows failed', e);
}
const channelData = mergeSheetCategories(channel, sheetCategories) || CHANNEL_MAP[channel];
const subData = channelData?.subs?.[sub];

if (!channelData || !subData) {
  return Astro.redirect('/04-channels', 302);
}

const color = channelData.color;
const freeCount = subData.freeCount || 0;
// 카테고리 자체가 유료(subData.free가 false)면 freeCount가 없어도 전체 항목이 잠겨야 한다.
// entertainment 채널은 채널 전체가 무료라 예외로 취급.
const categoryIsFree = channel === 'entertainment' || !!subData.free;

const items = withItemSlugs(rawItems);
const lockedCount = categoryIsFree
  ? 0
  : (freeCount > 0 ? Math.max(items.length - freeCount, 0) : items.length);

// mini 채널은 지역별 항목 수가 많아(3hour 126개, recommend 79개 등) 지역 필터 칩을 추가로 노출.
// region 필드 앞부분(시/도)만 뽑아 중복 제거 + 항목 수 기준 내림차순 정렬.
const showRegionFilter = channel === 'mini' && items.length > 8;
let regionCounts = [];
if (showRegionFilter) {
  const counts = new Map();
  items.forEach((item) => {
    const sido = extractSido(item);
    if (!sido) return;
    counts.set(sido, (counts.get(sido) || 0) + 1);
  });
  regionCounts = [...counts.entries()].sort((a, b) => b[1] - a[1]);
}
---
<Layout title={`taerijay+${channel} · ${subData.kr} | TAERIJAY`}>
  <div class="sub-page" style={`--c:${color}`}>
    <div class="sub-topbar">
      <button type="button" class="back-btn" onclick="history.back()">← 뒤로가기</button>
    </div>

    <section class="sub-hero">
      <a href={`/04-channels/${channel}`} class="sub-parent-link notranslate" translate="no">taerijay+{channel}</a>
      <h1 class="sub-title">
        <span class="sub-title-kr">{subData.kr}</span>
        <span class="sub-title-en" data-i18n="en">{subData.en}</span>
      </h1>
      {items.length > 0 && (
        <p class="sub-count">
          <span class="sub-count-kr">총 {items.length}개{lockedCount > 0 && ` · 🔒 ${lockedCount}개는 구독 후 열람`}</span>
          <span class="sub-count-en" data-i18n="en">{items.length} items</span>
        </p>
      )}
      {lockedCount > 0 && (
        <div class="lock-progress">
          <div class="lock-progress-track">
            <div class="lock-progress-fill" style={`width:${Math.round(((items.length - lockedCount) / items.length) * 100)}%`}></div>
          </div>
          <p class="lock-progress-label">
            <span class="lock-progress-label-kr">무료 {items.length - lockedCount}개 공개 중 · 전체 {items.length}개는 구독하면 바로 열람</span>
            <span class="lock-progress-label-en" data-i18n="en">{items.length - lockedCount} free now · unlock all {items.length} with a subscription</span>
          </p>
        </div>
      )}
    </section>

    {loadError && (
      <section class="empty-note">
        <p>콘텐츠 로드 실패. 잠시 후 재시도</p>
        <p class="empty-note-en">Failed to load content. Please try again shortly.</p>
      </section>
    )}

    {!loadError && items.length === 0 && (
      <section class="empty-note">
        <p>콘텐츠 준비 중</p>
        <p class="empty-note-en">Content coming soon.</p>
      </section>
    )}

    {showRegionFilter && regionCounts.length > 1 && (
      <div class="region-filter" id="regionFilter">
        <button type="button" class="region-chip is-active" data-region="all">전체 <span class="region-chip-en">All</span> <span class="region-chip-count">{items.length}</span></button>
        {regionCounts.map(([sido, count]) => (
          <button type="button" class="region-chip notranslate" translate="no" data-region={sido}>{sido} <span class="region-chip-count">{count}</span></button>
        ))}
      </div>
    )}

    {!loadError && items.length > 0 && (
      <section class="item-grid-section" id="itemGrid">
        {items.map((item, idx) => {
          const isLocked = categoryIsFree ? false : (freeCount > 0 ? idx >= freeCount : true);
          const sido = extractSido(item);
          return (
            <a
              href={`/04-channels/${channel}/${sub}/${item.itemSlug}`}
              class={`item-card-tile${isLocked ? ' item-card-tile-locked' : ''}`}
              data-region={sido || ''}
            >
              <div class="item-card-tile-art">
                <span class={`cat-card-tier notranslate ${isLocked ? 'is-paid' : 'is-free'}`} translate="no">{isLocked ? 'PAID' : 'FREE'}</span>
                <span class="item-card-tile-name notranslate" translate="no">{item.title_kr}</span>
                {item.title_en && <span class="item-card-tile-name-en">{item.title_en}</span>}
                {sido && <span class="item-card-tile-region notranslate" translate="no">{sido}</span>}
              </div>
              {isLocked && (
                <div class="item-card-tile-lockmask">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                </div>
              )}
            </a>
          );
        })}
        {lockedCount > 0 && (
          <a href="/pricing" class="item-card-tile item-card-tile-more">
            <div class="item-card-tile-art item-card-tile-more-art">
              <span class="item-card-tile-more-num">+{lockedCount}</span>
              <span class="item-card-tile-more-label-kr">더보기 · 구독하고 전체 열람</span>
              <span class="item-card-tile-more-label-en">unlock all with a subscription</span>
            </div>
          </a>
        )}
      </section>
    )}

    {showRegionFilter && (
      <p class="region-empty-note" id="regionEmptyNote" hidden>
        <span>선택 지역 콘텐츠 없음</span>
        <span class="region-empty-note-en">No content found for this region.</span>
      </p>
    )}
  </div>

  {showRegionFilter && (
    <script>
      const filterBar = document.getElementById('regionFilter');
      const grid = document.getElementById('itemGrid');
      const emptyNote = document.getElementById('regionEmptyNote');
      if (filterBar && grid) {
        filterBar.addEventListener('click', (e) => {
          const btn = e.target.closest('.region-chip');
          if (!btn) return;
          filterBar.querySelectorAll('.region-chip').forEach((c) => c.classList.remove('is-active'));
          btn.classList.add('is-active');
          const region = btn.getAttribute('data-region');
          let visibleCount = 0;
          grid.querySelectorAll('.item-card-tile:not(.item-card-tile-more)').forEach((card) => {
            const match = region === 'all' || card.getAttribute('data-region') === region;
            card.hidden = !match;
            if (match) visibleCount++;
          });
          if (emptyNote) emptyNote.hidden = visibleCount > 0;
        });
      }
    </script>
  )}

  <style>
    .sub-count{margin-top:10px;display:flex;flex-direction:column;gap:2px}
    .sub-count-kr{font-size:clamp(.72rem,1.9vw,.86rem);color:var(--kr-bright)}
    .sub-count-en{font-size:clamp(.72rem,1.9vw,.86rem);color:var(--ivory);font-weight:700;text-transform:uppercase}

    .region-filter{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0 24px}
    .region-chip{
      display:inline-flex;align-items:center;gap:5px;background:rgba(255,255,255,.05);
      border:1px solid rgba(255,255,255,.14);border-radius:100px;padding:6px 14px;
      color:var(--muted);font-size:.8rem;font-weight:600;cursor:pointer;transition:background .2s ease,border-color .2s ease,color .2s ease;
    }
    .region-chip:hover{background:rgba(255,255,255,.09)}
    .region-chip.is-active{background:color-mix(in srgb, var(--c) 18%, transparent);border-color:color-mix(in srgb, var(--c) 50%, transparent);color:var(--ivory)}
    .region-chip-en{color:var(--dim);font-size:.72rem}
    .region-chip-count{color:var(--dim);font-size:.72rem}
    .region-chip.is-active .region-chip-count{color:var(--c)}

    .region-empty-note{margin:24px 0;padding:20px;text-align:center;color:var(--dim);font-size:.86rem;border:1px dashed rgba(255,255,255,.14);border-radius:12px}
    .region-empty-note-en{display:block;margin-top:4px;color:var(--muted);font-size:.78rem}
  </style>
</Layout>
