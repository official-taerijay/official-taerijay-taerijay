---
// 이 페이지는 더 이상 정적 빌드되지 않고, 요청 시점에 구글시트에서 콘텐츠를 읽어온다.
// 구글시트에서 행을 추가/수정/삭제하면 재배포 없이 바로 반영됨 (최대 60초 캐시).
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { CHANNEL_MAP } from '../../../lib/channelCategories.js';
import { fetchChannelRows } from '../../../lib/sheetsCms.js';
import '../../../styles/channel-page.css';

const { channel, sub } = Astro.params;
const channelData = CHANNEL_MAP[channel];
const subData = channelData?.subs?.[sub];

if (!channelData || !subData) {
  return Astro.redirect('/04-channels', 302);
}

const color = channelData.color;
// entertainment 채널 전체 + 각 채널의 free:true 카테고리는 로그인/이용권 확인 없이 열람 가능
const requireChannel = (channel === 'entertainment' || subData.free) ? '' : channel;

let items = [];
let loadError = false;
try {
  const allRows = await fetchChannelRows(channel);
  items = allRows.filter((r) => (r.sub || '').trim() === sub);
} catch (e) {
  console.error('[sub-page] sheet fetch failed', e);
  loadError = true;
}
---
<Layout title={`taerijay+${channel} · ${subData.kr} | TAERIJAY`} requireChannel={requireChannel}>
  <div class="sub-page" style={`--c:${color}`}>
    <div class="sub-topbar">
      <button type="button" class="back-btn" onclick="history.back()">← 뒤로가기</button>
    </div>

    <section class="sub-hero">
      <a href={`/04-channels/${channel}`} class="sub-parent-link">taerijay+{channel}</a>
      <h1 class="sub-title">
        <span class="sub-title-kr">{subData.kr}</span>
        <span class="sub-title-en" data-i18n="en">{subData.en}</span>
      </h1>
    </section>

    {loadError && (
      <section class="empty-note">
        <p>콘텐츠를 불러오지 못했습니다. 잠시 후 다시 시도해주세요.</p>
        <p class="empty-note-en">Failed to load content. Please try again shortly.</p>
      </section>
    )}

    {!loadError && items.length === 0 && (
      <section class="empty-note">
        <p>콘텐츠 준비 중입니다.</p>
        <p class="empty-note-en">Content coming soon.</p>
      </section>
    )}

    {!loadError && items.length > 0 && (
      <section class="item-list">
        <p class="content-notice notranslate" translate="no">
          💡 본 콘텐츠는 AI 도구를 활용해 정리되었으며, 순차적으로 웹검색 팩트체크를 진행 중입니다. 실제 방문 전 최신 정보를 별도로 확인해 주세요.
          <span class="content-notice-en">Some content is AI-assisted and undergoing fact-check verification. Please confirm details before visiting.</span>
        </p>
        {items.map((item) => (
          <article class="item-card">
            <div class="item-card-head">
              <h2 class="item-title-kr notranslate" translate="no">{item.title_kr}</h2>
              {item.title_en && <p class="item-title-en">{item.title_en}</p>}
            </div>

            {(item.region) && (
              <span class="item-tag notranslate" translate="no">{item.region}</span>
            )}
            {(item.platform) && (
              <span class="item-tag notranslate" translate="no">{item.platform}</span>
            )}
            {(item.brand_kr) && (
              <span class="item-tag notranslate" translate="no">{item.brand_kr}</span>
            )}

            {(item.desc_kr) && (
              <p class="item-desc-kr notranslate" translate="no">{item.desc_kr}</p>
            )}
            {(item.desc_en) && <p class="item-desc-en">{item.desc_en}</p>}

            <div class="item-meta">
              {item.addr_kr && (
                <div class="item-meta-row">
                  <span class="item-meta-label">주소</span>
                  <span class="item-meta-value notranslate" translate="no">{item.addr_kr}</span>
                </div>
              )}
              {item.hours_kr && (
                <div class="item-meta-row">
                  <span class="item-meta-label">시간</span>
                  <span class="item-meta-value notranslate" translate="no">{item.hours_kr}</span>
                </div>
              )}
              {item.route_kr && (
                <div class="item-meta-row">
                  <span class="item-meta-label">동선</span>
                  <span class="item-meta-value notranslate" translate="no">{item.route_kr}</span>
                </div>
              )}
              {item.duration && (
                <div class="item-meta-row">
                  <span class="item-meta-label">소요시간</span>
                  <span class="item-meta-value notranslate" translate="no">{item.duration}</span>
                </div>
              )}
              {item.budget_kr && (
                <div class="item-meta-row">
                  <span class="item-meta-label">예산</span>
                  <span class="item-meta-value notranslate" translate="no">{item.budget_kr}</span>
                </div>
              )}
              {item.price_kr && (
                <div class="item-meta-row">
                  <span class="item-meta-label">가격대</span>
                  <span class="item-meta-value notranslate" translate="no">{item.price_kr}</span>
                </div>
              )}
              {item.genre && (
                <div class="item-meta-row">
                  <span class="item-meta-label">장르</span>
                  <span class="item-meta-value notranslate" translate="no">{item.genre}{item.year ? ` · ${item.year}` : ''}</span>
                </div>
              )}
              {item.cast_kr && (
                <div class="item-meta-row">
                  <span class="item-meta-label">출연</span>
                  <span class="item-meta-value notranslate" translate="no">{item.cast_kr}</span>
                </div>
              )}
            </div>

            {item.tips_kr && (
              <p class="item-tips">
                <span class="item-tips-kr notranslate" translate="no">💡 {item.tips_kr}</span>
                {item.tips_en && <span class="item-tips-en">{item.tips_en}</span>}
              </p>
            )}

            <div class="item-links">
              {item.naver_map && <a href={item.naver_map} target="_blank" rel="noopener noreferrer" class="item-link-btn">네이버지도</a>}
              {item.kakao_map && <a href={item.kakao_map} target="_blank" rel="noopener noreferrer" class="item-link-btn">카카오맵</a>}
              {item.web && <a href={item.web} target="_blank" rel="noopener noreferrer" class="item-link-btn item-link-btn-web">공식 웹사이트</a>}
            </div>
          </article>
        ))}
      </section>
    )}
  </div>

  <style>
    .item-list{display:flex;flex-direction:column;gap:20px;margin-bottom:40px}
    .content-notice{font-size:.76rem;color:var(--dim);line-height:1.6;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:10px 14px;margin-bottom:4px}
    .content-notice-en{display:block;margin-top:2px;color:var(--dim);opacity:.8}
    .item-card{
      border:1px solid color-mix(in srgb, var(--c) 30%, transparent);border-radius:16px;padding:22px 24px;
      background:linear-gradient(160deg, color-mix(in srgb, var(--c) 6%, var(--bg)) 0%, var(--bg) 60%);
      transition:border-color .2s ease, box-shadow .2s ease;
    }
    .item-card:hover{border-color:color-mix(in srgb, var(--c) 55%, transparent);box-shadow:0 12px 30px -14px color-mix(in srgb, var(--c) 40%, transparent)}
    .item-card-head{margin-bottom:8px}
    .item-title-kr{font-family:var(--f-display);font-weight:800;font-size:clamp(1.05rem,3vw,1.3rem);color:var(--ivory);word-break:keep-all}
    .item-title-en{font-size:.78rem;letter-spacing:.04em;color:var(--muted);text-transform:uppercase;margin-top:2px}
    .item-tag{display:inline-block;font-size:.68rem;font-weight:700;color:var(--c);background:color-mix(in srgb, var(--c) 16%, transparent);border:1px solid color-mix(in srgb, var(--c) 40%, transparent);border-radius:100px;padding:3px 10px;margin-bottom:10px}
    .item-desc-kr{font-size:.86rem;color:var(--ivory);line-height:1.65;margin-top:8px;white-space:pre-line;word-break:keep-all}
    .item-desc-en{font-size:.8rem;color:var(--muted);line-height:1.6;margin-top:4px;white-space:pre-line}
    .item-meta{display:flex;flex-direction:column;gap:6px;margin-top:14px;padding-top:14px;border-top:1px solid rgba(255,255,255,.08)}
    .item-meta-row{display:flex;gap:10px;font-size:.82rem}
    .item-meta-label{flex:0 0 56px;color:var(--dim);font-weight:700}
    .item-meta-value{color:var(--muted);word-break:keep-all}
    .item-tips{margin-top:14px;font-size:.82rem;line-height:1.6;display:flex;flex-direction:column;gap:2px}
    .item-tips-kr{color:var(--gold);word-break:keep-all}
    .item-tips-en{color:var(--dim);font-size:.78rem}
    .item-links{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}
    .item-link-btn{text-decoration:none;font-size:.76rem;font-weight:700;color:var(--ivory);background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);border-radius:100px;padding:6px 14px;transition:background .2s ease}
    .item-link-btn:hover{background:rgba(255,255,255,.14)}
    .item-link-btn-web{border-color:color-mix(in srgb, var(--c) 45%, transparent);color:var(--c)}
  </style>
</Layout>
