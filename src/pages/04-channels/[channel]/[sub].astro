---
// 카테고리 안의 "항목 카드 그리드" 페이지 (넷플릭스 스타일 3단 구조의 2단계).
// 흐름: 채널 인덱스 → 카테고리(cat-card) → 이 페이지(item-card 그리드) → [item].astro(6섹션 상세)
// 구글시트에서 행을 추가/수정/삭제하면 재배포 없이 바로 반영됨 (최대 60초 캐시).
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { CHANNEL_MAP, mergeSheetCategories } from '../../../lib/channelCategories.js';
import { fetchChannelRows, deriveCategoriesFromRows, toStr } from '../../../lib/sheetsCms.js';
import { withItemSlugs, extractSido, sidoToEn } from '../../../lib/itemHelpers.js';
import '../../../styles/channel-page.css';

// 동시접속 대량 트래픽 대비: 공개 콘텐츠라 Vercel Edge CDN이 60초간 캐싱하도록 지시
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

const { channel, sub } = Astro.params;

let allRows = [];
let rawItems = [];
let loadError = false;
try {
  allRows = await fetchChannelRows(channel);
  rawItems = allRows.filter((r) => toStr(r.sub) === sub);
} catch (e) {
  console.error('[sub-index] sheet fetch failed', e);
  loadError = true;
}

// 시트의 sub_kr/sub_en/sub_free 컬럼으로 카테고리 메타(이름/무료여부)를 자동 인식.
// 시트에 없는 카테고리는 channelCategories.js의 기존 정의를 그대로 사용(하위호환).
// 카테고리 도출 로직이 예기치 않은 데이터로 실패해도 하드코딩된 CHANNEL_MAP으로 폴백해
// 페이지 전체가 500 에러로 죽지 않도록 방어.
let sheetCategories = [];
try {
  sheetCategories = deriveCategoriesFromRows(allRows);
} catch (e) {
  console.error('[sub-index] deriveCategoriesFromRows failed', e);
}
const channelData = mergeSheetCategories(channel, sheetCategories) || CHANNEL_MAP[channel];
const subData = channelData?.subs?.[sub];

if (!channelData || !subData) {
  return Astro.redirect('/04-channels', 302);
}

const color = channelData.color;
const freeCount = subData.freeCount || 0;
// 카테고리 자체가 유료(subData.free가 false)면 freeCount가 없어도 전체 항목이 잠겨야 한다.
// entertainment 채널은 채널 전체가 무료라 예외로 취급.
const categoryIsFree = channel === 'entertainment' || !!subData.free;

const items = withItemSlugs(rawItems);
const lockedCount = categoryIsFree
  ? 0
  : (freeCount > 0 ? Math.max(items.length - freeCount, 0) : items.length);

// entertainment 채널(드라마/영화/예능)은 항목 수가 많고 개별 작품마다 포스터를 두지 않는 대신,
// 9개 장르 버킷(item.img의 파일명, 예: thriller.png)을 기준으로 큰 장르 그룹으로 묶어서
// 장르 대표 이미지 아래에 그 장르에 속한 작품들을 텍스트 리스트로 보여준다.
// (요청: 드라마 > 스릴러(포스터) > 더 글로리, 세부 genre 텍스트가 제각각이라
//  실제 그룹핑은 이미 9종으로 정리된 img 경로를 키로 사용한다.)
const GENRE_BUCKET_LABELS = {
  thriller: { kr: '스릴러', en: 'Thriller' },
  romance: { kr: '로맨스', en: 'Romance' },
  comedy: { kr: '코미디', en: 'Comedy' },
  'legal-medical': { kr: '법정/메디컬', en: 'Legal & Medical' },
  horror: { kr: '호러', en: 'Horror' },
  period: { kr: '사극', en: 'Period' },
  human: { kr: '휴먼드라마', en: 'Human Drama' },
  scifi: { kr: 'SF', en: 'Sci-Fi' },
  drama: { kr: '드라마', en: 'Drama' },
};
// 채널 전체를 관통하는 공통 틀: "큰 카테고리(sub, 이미 상위 페이지에서 선택됨) → 중간 그룹 →
// 개별 항목" 3단 구조. 중간 그룹 기준은 채널 데이터 특성에 맞춰 다르게 잡는다.
//   - entertainment: 9개 장르 버킷(포스터 이미지 있음)
//   - mini: 지역(시/도, 이미지 없음 텍스트 헤더) — 기존 지역 필터 칩과 함께 사용
//   - red/green(다이소/올리브영): 브랜드명(이미지 없음 텍스트 헤더)
//   - protocol/mart: 항목이 이미 sub 자체로 충분히 세분화되어 있어 그룹핑 생략(기존 단일 그리드 유지)
const useGenreGroups = channel === 'entertainment';
// 브랜드/지역 그룹핑은 "실제로 그룹이 2종류 이상 나올 때만" 의미가 있다.
// (예: booking-tips처럼 전 항목이 '전국'뿐인 카테고리는 그룹 1개로 묶여봤자 의미가 없어
//  일반 카드 그리드로 그대로 보여준다.) 아래 두 후보 플래그는 그룹을 만들어본 뒤 최종 확정한다.
const wantsBrandGroups = channel === 'red' || channel === 'green';
const wantsRegionGroups = channel === 'mini' && items.length > 8;

let genreGroups = [];
if (useGenreGroups) {
  const order = [];
  const map = new Map();
  items.forEach((item, idx) => {
    const bucketKey = item.img ? item.img.split('/').pop().replace(/\.[a-z0-9]+$/i, '') : '';
    const key = bucketKey || 'etc';
    if (!map.has(key)) {
      map.set(key, []);
      order.push(key);
    }
    map.get(key).push({ item, idx });
  });
  genreGroups = order.map((key) => {
    const label = GENRE_BUCKET_LABELS[key] || { kr: items.find((it) => it.genre)?.genre || '기타', en: 'Other' };
    return {
      key,
      nameKr: label.kr,
      nameEn: label.en,
      img: map.get(key)[0]?.item.img || '',
      entries: map.get(key),
    };
  });
}

let brandGroups = [];
if (wantsBrandGroups) {
  const order = [];
  const map = new Map();
  items.forEach((item, idx) => {
    const key = (item.brand_kr || '').trim() || '기타';
    if (!map.has(key)) {
      map.set(key, []);
      order.push(key);
    }
    map.get(key).push({ item, idx });
  });
  // 항목 수 많은 브랜드 순으로 정렬해 주요 브랜드가 먼저 보이게 함
  order.sort((a, b) => map.get(b).length - map.get(a).length);
  brandGroups = order.map((key) => ({
    key,
    nameKr: key,
    nameEn: '',
    img: '',
    entries: map.get(key),
  }));
}
// 브랜드가 딱 1종류뿐이면(예: 카테고리 전체가 한 브랜드) 그룹핑 의미가 없어 일반 그리드로 대체
const useBrandGroups = wantsBrandGroups && brandGroups.length > 1;

// mini 채널은 지역별 항목 수가 많아(3hour 126개, recommend 79개 등) 지역 필터 칩을 추가로 노출.
// region 필드 앞부분(시/도)만 뽑아 중복 제거. 정렬은 "서울이 항상 맨 앞, 그 다음은 항목 수 내림차순".
const regionSortKey = (sido) => (sido === '서울' ? -Infinity : 0);
let regionCounts = [];
let regionGroups = [];
if (wantsRegionGroups) {
  const counts = new Map();
  const order = [];
  const map = new Map();
  items.forEach((item, idx) => {
    const sido = extractSido(item);
    if (!sido) return;
    counts.set(sido, (counts.get(sido) || 0) + 1);
    const key = sido;
    if (!map.has(key)) {
      map.set(key, []);
      order.push(key);
    }
    map.get(key).push({ item, idx });
  });
  regionCounts = [...counts.entries()].sort((a, b) => {
    const bias = regionSortKey(a[0]) - regionSortKey(b[0]);
    return bias !== 0 ? bias : b[1] - a[1];
  });
  order.sort((a, b) => {
    const bias = regionSortKey(a) - regionSortKey(b);
    return bias !== 0 ? bias : map.get(b).length - map.get(a).length;
  });
  regionGroups = order.map((key) => ({
    key,
    nameKr: key,
    nameEn: sidoToEn(key),
    img: '',
    entries: map.get(key),
  }));
}
// 지역이 사실상 '전국' 하나뿐이면(예: booking-tips) 그룹핑 없이 일반 그리드로 대체.
// 단, 지역 필터 칩(showRegionFilter)은 항목이 8개 넘으면 그대로 유지해도 무방하므로 별도 조건 유지.
const useRegionGroups = wantsRegionGroups && regionGroups.length > 1;
const showRegionFilter = wantsRegionGroups && regionCounts.length > 1;
const useCardGroups = useGenreGroups || useBrandGroups || useRegionGroups;

const cardGroups = useGenreGroups ? genreGroups : (useBrandGroups ? brandGroups : regionGroups);
---
<Layout title={`taerijay+${channel} · ${subData.kr} | TAERIJAY`}>
  <div class="sub-page" style={`--c:${color}`}>
    <div class="sub-topbar">
      <button type="button" class="back-btn" onclick="history.back()">← 뒤로가기</button>
    </div>

    <section class="sub-hero">
      <a href={`/04-channels/${channel}`} class="sub-parent-link notranslate" translate="no">taerijay+{channel}</a>
      <h1 class="sub-title">
        <span class="sub-title-kr">{subData.kr}</span>
        <span class="sub-title-en" data-i18n="en">{subData.en}</span>
      </h1>
      {items.length > 0 && (
        <p class="sub-count">
          <span class="sub-count-pair">
            <span class="sub-count-kr notranslate" translate="no">무료 {items.length - lockedCount}개 · FREE {items.length - lockedCount}</span>
            {lockedCount > 0 && <span class="sub-count-kr notranslate" translate="no"> · 유료 {lockedCount}개 · PAID {lockedCount}</span>}
          </span>
          <span class="sub-count-en" data-i18n="en">{items.length} items total{lockedCount > 0 && ` · ${lockedCount} require a subscription`}</span>
        </p>
      )}
      {lockedCount > 0 && (
        <div class="lock-progress">
          <div class="lock-progress-track">
            <div class="lock-progress-fill" style={`width:${Math.round(((items.length - lockedCount) / items.length) * 100)}%`}></div>
          </div>
          <p class="lock-progress-label">
            <span class="lock-progress-label-kr">무료 {items.length - lockedCount}개 공개 중 · 전체 {items.length}개는 구독하면 바로 열람</span>
            <span class="lock-progress-label-en" data-i18n="en">{items.length - lockedCount} free now · unlock all {items.length} with a subscription</span>
          </p>
        </div>
      )}
    </section>

    {loadError && (
      <section class="empty-note">
        <p>콘텐츠 로드 실패. 잠시 후 재시도</p>
        <p class="empty-note-en">Failed to load content. Please try again shortly.</p>
      </section>
    )}

    {!loadError && items.length === 0 && (
      <section class="empty-note">
        <p>콘텐츠 준비 중</p>
        <p class="empty-note-en">Content coming soon.</p>
      </section>
    )}

    {showRegionFilter && regionCounts.length > 1 && (
      <div class="region-filter" id="regionFilter">
        <button type="button" class="region-chip is-active" data-region="all">
          <span class="region-chip-text">
            <span class="region-chip-kr notranslate" translate="no">전체 <span class="region-chip-count">{items.length}</span></span>
            <span class="region-chip-en">All <span class="region-chip-count">{items.length}</span></span>
          </span>
        </button>
        {regionCounts.map(([sido, count]) => (
          <button type="button" class="region-chip" data-region={sido}>
            <span class="region-chip-text">
              <span class="region-chip-kr notranslate" translate="no">{sido} <span class="region-chip-count">{count}</span></span>
              <span class="region-chip-en">{sidoToEn(sido)} <span class="region-chip-count">{count}</span></span>
            </span>
          </button>
        ))}
      </div>
    )}

    {!loadError && items.length > 0 && useCardGroups && (
      <div class="genre-groups" id="itemGrid">
        {cardGroups.map((group) => (
          <section class="genre-group" data-group={group.key}>
            <div class="genre-group-header">
              {group.img && (
                <div class="genre-group-poster">
                  <img src={group.img} alt="" loading="lazy" />
                </div>
              )}
              <div class="genre-group-title">
                <span class="genre-group-name notranslate" translate="no">
                  {group.nameKr}{group.nameEn && <span class="genre-group-name-en">{group.nameEn}</span>}
                </span>
                <span class="genre-group-count notranslate" translate="no">총 {group.entries.length}개 · {group.entries.length} items</span>
              </div>
            </div>
            <div class="item-grid-section">
              {group.entries.map(({ item, idx }) => {
                const isLocked = categoryIsFree ? false : (freeCount > 0 ? idx >= freeCount : true);
                const sido = extractSido(item);
                return (
                  <a
                    href={`/04-channels/${channel}/${sub}/${item.itemSlug}`}
                    class={`item-card-tile item-card-tile-text-only${isLocked ? ' item-card-tile-locked' : ''}`}
                    data-region={sido || ''}
                  >
                    <div class="item-card-tile-art">
                      <span class={`cat-card-tier notranslate ${isLocked ? 'is-paid' : 'is-free'}`} translate="no">{isLocked ? '유료 PAID' : '무료 FREE'}</span>
                      <span class="item-card-tile-name notranslate" translate="no">{item.title_kr}</span>
                      {item.title_en && <span class="item-card-tile-name-en">{item.title_en}</span>}
                      {sido && <span class="item-card-tile-region notranslate" translate="no">{sido}</span>}
                    </div>
                    {isLocked && (
                      <div class="item-card-tile-lockmask">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                      </div>
                    )}
                  </a>
                );
              })}
            </div>
          </section>
        ))}
        {lockedCount > 0 && (
          <a href="/pricing" class="genre-group-unlock">
            <span class="genre-group-unlock-kr">+{lockedCount}개 더보기 · 구독하고 전체 열람</span>
            <span class="genre-group-unlock-en">unlock all {lockedCount} more with a subscription</span>
          </a>
        )}
      </div>
    )}

    {!loadError && items.length > 0 && !useCardGroups && (
      <section class="item-grid-section" id="itemGrid">
        {items.map((item, idx) => {
          const isLocked = categoryIsFree ? false : (freeCount > 0 ? idx >= freeCount : true);
          const sido = extractSido(item);
          return (
            <a
              href={`/04-channels/${channel}/${sub}/${item.itemSlug}`}
              class={`item-card-tile${isLocked ? ' item-card-tile-locked' : ''}`}
              data-region={sido || ''}
            >
              <div class={`item-card-tile-art${item.img ? ' item-card-tile-art-has-img' : ''}`}>
                {item.img && (
                  <img
                    src={item.img}
                    alt=""
                    class="item-card-tile-bg"
                    loading="lazy"
                    onerror="this.remove(); this.closest('.item-card-tile-art')?.classList.remove('item-card-tile-art-has-img');"
                  />
                )}
                <span class={`cat-card-tier notranslate ${isLocked ? 'is-paid' : 'is-free'}`} translate="no">{isLocked ? '유료 PAID' : '무료 FREE'}</span>
                <span class="item-card-tile-name notranslate" translate="no">{item.title_kr}</span>
                {item.title_en && <span class="item-card-tile-name-en">{item.title_en}</span>}
                {sido && <span class="item-card-tile-region notranslate" translate="no">{sido}</span>}
              </div>
              {isLocked && (
                <div class="item-card-tile-lockmask">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                </div>
              )}
            </a>
          );
        })}
        {lockedCount > 0 && (
          <a href="/pricing" class="item-card-tile item-card-tile-more">
            <div class="item-card-tile-art item-card-tile-more-art">
              <span class="item-card-tile-more-num">+{lockedCount}</span>
              <span class="item-card-tile-more-label-kr">더보기 · 구독하고 전체 열람</span>
              <span class="item-card-tile-more-label-en">unlock all with a subscription</span>
            </div>
          </a>
        )}
      </section>
    )}

    {showRegionFilter && (
      <p class="region-empty-note" id="regionEmptyNote" hidden>
        <span>선택 지역 콘텐츠 없음</span>
        <span class="region-empty-note-en">No content found for this region.</span>
      </p>
    )}
  </div>

  {showRegionFilter && (
    <script>
      const filterBar = document.getElementById('regionFilter');
      const grid = document.getElementById('itemGrid');
      const emptyNote = document.getElementById('regionEmptyNote');
      if (filterBar && grid) {
        filterBar.addEventListener('click', (e) => {
          const btn = e.target.closest('.region-chip');
          if (!btn) return;
          filterBar.querySelectorAll('.region-chip').forEach((c) => c.classList.remove('is-active'));
          btn.classList.add('is-active');
          const region = btn.getAttribute('data-region');
          let visibleCount = 0;
          // 지역별 그룹 섹션 전체를 보이기/숨기기 (그룹핑 UI가 없는 채널은 카드 단위로 동작)
          const groups = grid.querySelectorAll('.genre-group[data-group]');
          if (groups.length > 0) {
            groups.forEach((group) => {
              const match = region === 'all' || group.getAttribute('data-group') === region;
              group.hidden = !match;
              if (match) visibleCount++;
            });
          } else {
            grid.querySelectorAll('.item-card-tile:not(.item-card-tile-more)').forEach((card) => {
              const match = region === 'all' || card.getAttribute('data-region') === region;
              card.hidden = !match;
              if (match) visibleCount++;
            });
          }
          if (emptyNote) emptyNote.hidden = visibleCount > 0;
        });
      }
    </script>
  )}

  <style>
    .sub-count{margin-top:10px;display:flex;flex-direction:column;gap:2px}
    .sub-count-pair{display:flex;flex-wrap:wrap;gap:2px}
    .sub-count-kr{font-size:clamp(.72rem,1.9vw,.86rem);color:var(--kr-bright)}
    .sub-count-en{font-size:clamp(.72rem,1.9vw,.86rem);color:var(--ivory);font-weight:700;text-transform:uppercase}

    /* entertainment 장르 그룹 섹션: 큰 장르 포스터 헤더 + 그 아래 텍스트 카드 리스트 */
    .genre-groups{display:flex;flex-direction:column;gap:36px;margin-top:8px}
    .genre-group-header{
      display:flex;align-items:center;gap:16px;padding-bottom:14px;margin-bottom:16px;
      border-bottom:1px solid rgba(255,255,255,.1);
    }
    .genre-group-poster{
      flex:none;width:64px;aspect-ratio:2/3;border-radius:8px;overflow:hidden;
      box-shadow:0 6px 18px rgba(0,0,0,.4);
    }
    .genre-group-poster img{width:100%;height:100%;object-fit:cover;display:block}
    .genre-group-title{display:flex;flex-direction:column;gap:4px;min-width:0}
    .genre-group-header:has(.genre-group-poster) .genre-group-title{padding-left:2px}
    .genre-group-header:not(:has(.genre-group-poster)){
      border-left:3px solid var(--c);padding-left:12px;
    }
    .genre-group-name{display:flex;flex-direction:column;gap:2px;font-size:clamp(1.05rem,2.6vw,1.35rem);font-weight:800;color:var(--ivory)}
    .genre-group-name-en{display:block;font-size:.62em;font-weight:700;color:var(--c);text-transform:uppercase;letter-spacing:.03em}
    .genre-group-count{font-size:clamp(.7rem,1.8vw,.8rem);color:var(--dim)}

    .item-card-tile-text-only .item-card-tile-art{
      aspect-ratio:auto;min-height:64px;justify-content:center;
      background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);
    }

    .genre-group-unlock{
      display:flex;flex-direction:column;align-items:center;gap:4px;
      margin-top:8px;padding:18px;text-align:center;border-radius:12px;
      border:1px dashed color-mix(in srgb, var(--c) 45%, transparent);
