---
// 넷플릭스 스타일 3단 구조의 마지막 단계 — 항목 하나의 진짜 상세페이지.
// 6개 섹션으로 구성: 1)주제소개 2)하차가이드 3)도착상세 4)위치정보 5)검색키워드/해시태그 6)꿀팁
export const prerender = false;

import Layout from '../../../../layouts/Layout.astro';
import { CHANNEL_MAP, mergeSheetCategories } from '../../../../lib/channelCategories.js';
import { fetchChannelRows, deriveCategoriesFromRows, toStr } from '../../../../lib/sheetsCms.js';
import { withItemSlugs, splitBullets, splitSentences, extractSido, priceKrToUsdHint } from '../../../../lib/itemHelpers.js';

// buy_kr 불릿 중 "가격대: 5,000원"처럼 원화 금액이 들어간 줄에 (약 USD x) 참고값을 붙여준다.
function withUsdHint(line) {
  if (!line || !line.includes('원')) return line;
  const hint = priceKrToUsdHint(line);
  return hint ? `${line} (${hint})` : line;
}

// entertainment 채널 전용: platform 필드(넷플릭스/디즈니+)로 공식 시청 페이지 홈을 매핑.
// 작품별 개별 URL은 검증되지 않은 값을 넣으면 깨진 링크가 될 위험이 있어
// 플랫폼 공식 홈으로 안내(사용자가 검색해 바로 찾을 수 있음).
const PLATFORM_HOME = {
  '넷플릭스': 'https://www.netflix.com/kr/',
  '디즈니+': 'https://www.disneyplus.com/ko-kr/home',
};
import '../../../../styles/channel-page.css';
import '../../../../styles/item-detail.css';

const { channel, sub, item: itemSlugParam } = Astro.params;

let allRows = [];
let rawItems = [];
let loadError = false;
try {
  allRows = await fetchChannelRows(channel);
  rawItems = allRows.filter((r) => toStr(r.sub) === sub);
} catch (e) {
  console.error('[item-detail] sheet fetch failed', e);
  loadError = true;
}

// 시트의 sub_kr/sub_en/sub_free 컬럼으로 카테고리 메타(이름/무료여부)를 자동 인식.
// 도출 로직이 예기치 않은 데이터로 실패해도 CHANNEL_MAP 하드코딩 값으로 폴백해 500을 방지.
let sheetCategories = [];
try {
  sheetCategories = deriveCategoriesFromRows(allRows);
} catch (e) {
  console.error('[item-detail] deriveCategoriesFromRows failed', e);
}
const channelData = mergeSheetCategories(channel, sheetCategories) || CHANNEL_MAP[channel];
const subData = channelData?.subs?.[sub];

if (!channelData || !subData) {
  return Astro.redirect('/04-channels', 302);
}

const color = channelData.color;
const freeCount = subData.freeCount || 0;

const items = withItemSlugs(rawItems);
const itemIdx = items.findIndex((it) => it.itemSlug === itemSlugParam);

if (!loadError && itemIdx === -1) {
  return Astro.redirect(`/04-channels/${channel}/${sub}`, 302);
}

const item = items[itemIdx];
// entertainment 채널 전체 + free:true 카테고리는 로그인/이용권 확인 없이 열람 가능.
// freeCount가 있는 카테고리는 인덱스가 freeCount 미만인 항목만 무료.
const isFreeItem = channel === 'entertainment' || subData.free || (freeCount > 0 && itemIdx < freeCount);
const requireChannel = isFreeItem ? '' : channel;

const sido = item ? extractSido(item) : '';
const prevItem = itemIdx > 0 ? items[itemIdx - 1] : null;
const nextItem = itemIdx < items.length - 1 ? items[itemIdx + 1] : null;

// 공항 카테고리는 항상 실내 시설 안내라 지도 버튼이 의미 없어 노출하지 않음.
const AIRPORT_SUBS = ['incheon-airport', 'gimpo-airport', 'gimhae-airport', 'jeju-airport'];
const isAirportSub = AIRPORT_SUBS.includes(sub);

// addr_kr이 실제 지번/도로명 주소가 아니라 "해당 없음", "온라인 신청" 같은
// 안내성 텍스트인 경우 지도 검색·주소 복사가 의미 없으므로 버튼을 숨긴다.
const NON_ADDRESS_HINTS = ['해당 없음', '해당없음', '온라인', '창구 없음', '제도 안내'];
const isRealAddress = item?.addr_kr && !NON_ADDRESS_HINTS.some((h) => item.addr_kr.includes(h));

const showMapButtons = isRealAddress && !isAirportSub;
const showAddrCopy = isRealAddress;
---
<Layout title={item ? `${item.title_kr} | taerijay+${channel} | TAERIJAY` : `taerijay+${channel} | TAERIJAY`} requireChannel={requireChannel}>
  <div class="item-detail-page" style={`--c:${color}`}>
    <div class="sub-topbar">
      <button type="button" class="back-btn" onclick="history.back()">← 뒤로가기</button>
    </div>

    {loadError && (
      <section class="empty-note">
        <p>콘텐츠를 불러오지 못했습니다. 잠시 후 다시 시도해주세요.</p>
        <p class="empty-note-en">Failed to load content. Please try again shortly.</p>
      </section>
    )}

    {!loadError && item && (
      <article class="item-detail">
        <a href={`/04-channels/${channel}/${sub}`} class="sub-parent-link notranslate" translate="no">taerijay+{channel} · {subData.kr}</a>

        <header class="item-detail-head">
          {sido && <span class="item-detail-region notranslate" translate="no">[{sido}]</span>}
          <h1 class="item-detail-title notranslate" translate="no">{item.title_kr}</h1>
          {item.title_en && <p class="item-detail-title-en notranslate" translate="no">{item.title_en}</p>}

          <div class="item-detail-tags">
            {item.region && <span class="item-tag notranslate" translate="no">{item.region}</span>}
            {item.platform && <span class="item-tag notranslate" translate="no">{item.platform}</span>}
            {item.brand_kr && <span class="item-tag notranslate" translate="no">{item.brand_kr}</span>}
          </div>
        </header>

        <p class="content-notice notranslate" translate="no">
          💡 실제 방문 전 한번 더 확인 필수!
          <span class="content-notice-en">Please double-check details before visiting.</span>
        </p>

        <p class="content-notice content-notice-search notranslate" translate="no">
          🔍 제목으로 검색하면 이미지 확인 가능.
          <span class="content-notice-en">Search the title online to see photos.</span>
        </p>

        <!-- 1) 주제소개 -->
        {item.desc_kr && (
          <section class="detail-section">
            <h2 class="detail-section-title"><span class="detail-section-num">1️⃣</span> <span class="detail-section-title-kr">주제 소개</span> <span class="detail-section-title-en">Overview</span></h2>
            <ul class="detail-line-list">
              {splitSentences(item.desc_kr).map((line, i) => (
                <li class="detail-line">
                  <span class="detail-line-kr notranslate" translate="no">{line}</span>
                  {splitSentences(item.desc_en)[i] && <span class="detail-line-en">{splitSentences(item.desc_en)[i]}</span>}
                </li>
              ))}
            </ul>
          </section>
        )}

        {item.desc_kr && (item.getoff_kr || item.direction_kr || item.route_kr) && <hr class="detail-divider" />}

        <!-- 2) 하차가이드 -->
        {item.getoff_kr && (
          <section class="detail-section">
            <h2 class="detail-section-title"><span class="detail-section-num">2️⃣</span> <span class="detail-section-title-kr">하차 가이드</span> <span class="detail-section-title-en">Get Off Here</span></h2>
            <ul class="detail-line-list">
              {splitBullets(item.getoff_kr).map((line, i) => (
                <li class="detail-line">
                  <span class="detail-line-kr notranslate" translate="no">{line}</span>
                  {splitBullets(item.getoff_en)[i] && <span class="detail-line-en">{splitBullets(item.getoff_en)[i]}</span>}
                </li>
              ))}
            </ul>
          </section>
        )}

        {item.getoff_kr && (item.direction_kr || item.route_kr) && <hr class="detail-divider" />}

        <!-- 3) 도착상세 (route_kr 재활용) -->
        {(item.direction_kr || item.route_kr) && (
          <section class="detail-section">
            <h2 class="detail-section-title"><span class="detail-section-num">3️⃣</span> <span class="detail-section-title-kr">도착 상세</span> <span class="detail-section-title-en">Direction Detail</span></h2>
            <ul class="detail-line-list">
              {splitBullets(item.direction_kr || item.route_kr).map((line, i) => (
                <li class="detail-line">
                  <span class="detail-line-kr notranslate" translate="no">📍 {line}</span>
                  {splitBullets(item.direction_en || item.route_en)[i] && <span class="detail-line-en">{splitBullets(item.direction_en || item.route_en)[i]}</span>}
                </li>
              ))}
            </ul>
          </section>
        )}

        {(item.direction_kr || item.route_kr) && (item.addr_kr || item.phone_kr || item.hours_kr || item.web || item.buy_kr) && <hr class="detail-divider" />}

        <!-- 4) 위치정보 (매장형 상품 채널은 buy_kr로 대체) -->
        {(item.addr_kr || item.phone_kr || item.hours_kr || item.web || item.buy_kr) && (
          <section class="detail-section">
            <h2 class="detail-section-title"><span class="detail-section-num">4️⃣</span> <span class="detail-section-title-kr">{item.buy_kr && !item.addr_kr ? '구매 가이드' : '위치 정보'}</span> <span class="detail-section-title-en">{item.buy_kr && !item.addr_kr ? 'Where to Buy' : 'Location Info'}</span></h2>
            {item.buy_kr && (
              <ul class="detail-line-list">
                {splitBullets(item.buy_kr).map((line, i) => (
                  <li class="detail-line">
                    <span class="detail-line-kr notranslate" translate="no">{withUsdHint(line)}</span>
                    {splitBullets(item.buy_en)[i] && <span class="detail-line-en">{splitBullets(item.buy_en)[i]}</span>}
                  </li>
                ))}
              </ul>
            )}
            <div class="item-meta">
              {item.addr_kr && (
                <div class="item-meta-row item-meta-row-addr">
                  <span class="item-meta-label notranslate" translate="no">🏠 주소 <span class="item-meta-label-en">Address</span></span>
                  <div class="item-meta-value-stack">
                    <span class="item-meta-value item-addr-value item-addr-kr notranslate" translate="no">{item.addr_kr}</span>
                    {item.addr_en && <span class="item-meta-value item-addr-value item-addr-en">{item.addr_en}</span>}
                  </div>
                  {showAddrCopy && (
                    <button type="button" class="addr-copy-btn" data-copy-text={item.addr_kr} aria-label="주소 복사" title="주소 복사 Copy address">
                      <svg class="addr-copy-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="7" y="7" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M13 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" stroke="currentColor" stroke-width="1.5"/>
                      </svg>
                      <span class="addr-copy-label">복사</span>
                    </button>
                  )}
                </div>
              )}
              {showMapButtons && <p class="item-detail-copy-hint">📝 복사해서 네이버/카카오/구글 맵에 붙여넣으세요. <span class="item-detail-copy-hint-en">Copy &amp; paste into Naver/Kakao/Google Map apps.</span></p>}
              {item.phone_kr && (
                <div class="item-meta-row item-meta-row-phone">
                  <span class="item-meta-label notranslate" translate="no">연락처 <span class="item-meta-label-en">Contact</span></span>
                  <span class="item-meta-value item-phone-value">{item.phone_kr}</span>
                  <div class="item-meta-row-actions">
                    <button type="button" class="addr-copy-btn" data-copy-text={item.phone_kr} aria-label="전화번호 복사" title="전화번호 복사 Copy number">
                      <svg class="addr-copy-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="7" y="7" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M13 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" stroke="currentColor" stroke-width="1.5"/>
                      </svg>
                      <span class="addr-copy-label">복사</span>
                    </button>
                    <a href={`tel:${item.phone_kr.replace(/[^0-9+]/g, '')}`} class="phone-call-btn" aria-label="전화 걸기" title="전화 걸기 Call">
                      <svg class="phone-call-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M6 2.5c.5 0 .9.3 1 .8l.6 2.4c.1.4 0 .9-.3 1.2l-1 1c.8 1.7 2.2 3.1 3.9 3.9l1-1c.3-.3.8-.4 1.2-.3l2.4.6c.5.1.8.5.8 1v2c0 .6-.4 1-1 1C8.9 15.1 4.9 11.1 4.5 5c0-.6.4-1 1-1H6Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                      </svg>
                      <span class="phone-call-label">전화</span>
                    </a>
                  </div>
                </div>
              )}
              {item.web && (
                <div class="item-meta-row item-meta-row-web">
                  <span class="item-meta-label notranslate" translate="no">🌐 웹사이트 <span class="item-meta-label-en">Website</span></span>
                  <span class="item-meta-value item-web-value notranslate" translate="no">{item.web.replace(/^https?:\/\//, '')}</span>
                  <button type="button" class="addr-copy-btn" data-copy-text={item.web} aria-label="웹사이트 주소 복사" title="웹사이트 주소 복사 Copy URL">
                    <svg class="addr-copy-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <rect x="7" y="7" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M13 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                    <span class="addr-copy-label">복사</span>
                  </button>
                </div>
              )}
              {item.hours_kr && (
                <div class="item-meta-row"><span class="item-meta-label notranslate" translate="no">시간</span><span class="item-meta-value">{item.hours_kr}</span></div>
              )}
              {item.duration && (
                <div class="item-meta-row"><span class="item-meta-label notranslate" translate="no">소요시간</span><span class="item-meta-value">{item.duration}</span></div>
              )}
              {item.budget_kr && (
                <div class="item-meta-row">
                  <span class="item-meta-label notranslate" translate="no">예산</span>
                  <span class="item-meta-value">{item.budget_kr}{priceKrToUsdHint(item.budget_kr) && ` (${priceKrToUsdHint(item.budget_kr)})`}</span>
                </div>
              )}
              {item.price_kr && !(item.buy_kr || '').includes('가격대') && (
                <div class="item-meta-row">
                  <span class="item-meta-label notranslate" translate="no">가격대</span>
                  <span class="item-meta-value">{item.price_kr}{priceKrToUsdHint(item.price_kr) && ` (${priceKrToUsdHint(item.price_kr)})`}</span>
                </div>
              )}
              {item.genre && (
                <div class="item-meta-row"><span class="item-meta-label notranslate" translate="no">장르</span><span class="item-meta-value">{item.genre}{item.year ? ` · ${item.year}` : ''}</span></div>
              )}
              {item.cast_kr && (
                <div class="item-meta-row"><span class="item-meta-label notranslate" translate="no">출연</span><span class="item-meta-value notranslate" translate="no">{item.cast_kr}</span></div>
              )}
            </div>
            {showMapButtons && (
              <div class="item-links item-links-maps">
                <a href={item.naver_map || `https://map.naver.com/v5/search/${encodeURIComponent(item.addr_kr)}`} target="_blank" rel="noopener noreferrer" class="item-link-btn item-link-btn-map notranslate" translate="no">네이버맵 <span class="item-link-btn-en">Naver Maps</span></a>
                <a href={item.kakao_map || `https://map.kakao.com/link/search/${encodeURIComponent(item.addr_kr)}`} target="_blank" rel="noopener noreferrer" class="item-link-btn item-link-btn-map notranslate" translate="no">카카오맵 <span class="item-link-btn-en">Kakao Map</span></a>
                <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(item.addr_en || item.addr_kr)}`} target="_blank" rel="noopener noreferrer" class="item-link-btn item-link-btn-map item-link-btn-google notranslate" translate="no">구글맵 <span class="item-link-btn-en">Google Maps</span></a>
              </div>
            )}
            {item.web && (
              <div class="item-links">
                <a href={item.web} target="_blank" rel="noopener noreferrer" class="item-link-btn item-link-btn-web notranslate" translate="no">🌐 공식 웹사이트 <span class="item-link-btn-en">Official Website</span></a>
              </div>
            )}
          </section>
        )}

        {(item.addr_kr || item.phone_kr || item.hours_kr || item.web || item.buy_kr) && (item.keywords_kr || item.hashtags) && <hr class="detail-divider" />}

        <!-- 5) 검색키워드 / 해시태그 -->
        {(item.keywords_kr || item.hashtags) && (
          <section class="detail-section">
            <h2 class="detail-section-title"><span class="detail-section-num">5️⃣</span> <span class="detail-section-title-kr">검색 및 해시태그</span> <span class="detail-section-title-en">Search &amp; Hashtags</span></h2>
            {item.keywords_kr && (
              <div class="keyword-block">
                <p class="keyword-block-label notranslate" translate="no">🔍 검색어 <span class="keyword-block-label-en">Search Keywords</span></p>
                <ul class="keyword-list notranslate" translate="no">
                  {splitBullets(item.keywords_kr).map((kw) => <li class="keyword-item">{kw}</li>)}
                </ul>
              </div>
            )}
            {item.hashtags && (
              <div class="keyword-block">
                <p class="keyword-block-label notranslate" translate="no">#️⃣ 해시태그 <span class="keyword-block-label-en">Hashtags</span></p>
                <ul class="hashtag-list notranslate" translate="no">
                  {splitBullets(item.hashtags).map((h) => <li class="hashtag-item">{h.startsWith('#') ? h : `#${h}`}</li>)}
                </ul>
              </div>
            )}
          </section>
        )}

        {(item.keywords_kr || item.hashtags) && item.tips_kr && <hr class="detail-divider" />}

        <!-- 6) 꿀팁 -->
        {item.tips_kr && (
          <section class="detail-section">
            <h2 class="detail-section-title"><span class="detail-section-num">6️⃣</span> <span class="detail-section-title-kr">꿀팁</span> <span class="detail-section-title-en">Insider Tip</span></h2>
            <ul class="item-tips-list">
              {splitBullets(item.tips_kr).map((line, i) => (
                <li class="item-tips-line">
                  <span class="item-tips-kr notranslate" translate="no">{line}</span>
                  {splitBullets(item.tips_en)[i] && <span class="item-tips-en">{splitBullets(item.tips_en)[i]}</span>}
                </li>
              ))}
            </ul>
          </section>
        )}

        {channel === 'entertainment' && (item.trailer_youtube || PLATFORM_HOME[item.platform]) && (
          <>
            <hr class="detail-divider" />
            <section class="detail-section">
              <h2 class="detail-section-title"><span class="detail-section-num">7️⃣</span> <span class="detail-section-title-kr">시청 링크</span> <span class="detail-section-title-en">Watch Links</span></h2>
              <div class="item-links">
                {PLATFORM_HOME[item.platform] && (
                  <a href={PLATFORM_HOME[item.platform]} target="_blank" rel="noopener noreferrer" class="item-link-btn item-link-btn-web notranslate" translate="no">🌐 공식 웹사이트 <span class="item-link-btn-en">Official Website</span></a>
                )}
                {item.trailer_youtube && (
                  <a href={item.trailer_youtube} target="_blank" rel="noopener noreferrer" class="item-link-btn item-link-btn-web notranslate" translate="no">▶️ 유튜브 예고편 <span class="item-link-btn-en">YouTube Trailer</span></a>
                )}
              </div>
            </section>
          </>
        )}

        <nav class="item-detail-pager">
          {prevItem ? (
            <a href={`/04-channels/${channel}/${sub}/${prevItem.itemSlug}`} class="item-pager-btn item-pager-prev">← <span class="notranslate" translate="no">{prevItem.title_kr}</span></a>
          ) : <span />}
          {nextItem ? (
            <a href={`/04-channels/${channel}/${sub}/${nextItem.itemSlug}`} class="item-pager-btn item-pager-next"><span class="notranslate" translate="no">{nextItem.title_kr}</span> →</a>
          ) : <span />}
        </nav>
      </article>
    )}
  </div>

  <script>
    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('.addr-copy-btn');
      if (!btn) return;
      const text = btn.getAttribute('data-copy-text') || '';
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch (err) {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const label = btn.querySelector('.addr-copy-label');
      const originalText = label ? label.textContent : '';
      btn.classList.add('addr-copy-btn-done');
      if (label) label.textContent = '복사됨';
      setTimeout(() => {
        btn.classList.remove('addr-copy-btn-done');
        if (label) label.textContent = originalText;
      }, 1500);
    });
  </script>
</Layout>
