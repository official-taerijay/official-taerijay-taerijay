---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import HeroSlider from '../../components/HeroSlider.astro';
import { CHANNEL_MAP, mergeSheetCategories } from '../../lib/channelCategories.js';
import { fetchChannelRows, deriveCategoriesFromRows } from '../../lib/sheetsCms.js';
import '../../styles/channel-page.css';

// 뷰티 매장 컨셉 — 실제 이미지는 img 필드에 추후 URL만 채워넣으면 자동 반영됨(현재는 그라디언트 대체)
const heroSlides = [
  { titleKr: '오늘의 대란템, 매장에서 바로', titleEn: "Today's Viral Pick", dateLabel: '10일·20일 리뉴얼', img: '/images/channels/red/hero-1.png' },
  { titleKr: '즉시 세금환급, 여행 중에도 간편하게', titleEn: 'Instant Tax Refund', dateLabel: 'TAX FREE', img: '/images/channels/red/hero-2.png' },
  { titleKr: '트렌드는 여기서 시작된다', titleEn: 'Where Trends Begin', dateLabel: 'K-BEAUTY', img: '/images/channels/red/hero-3.png' },
];

// 카테고리 목록은 코드에 하드코딩하지 않고 시트(sub/sub_kr/sub_en/sub_free/sub_order 컬럼)에서 자동 도출.
let allRows = [];
try {
  allRows = await fetchChannelRows('red');
} catch (e) {
  console.error('[red-index] sheet fetch failed', e);
}
let sheetCategories = [];
try {
  sheetCategories = deriveCategoriesFromRows(allRows);
} catch (e) {
  console.error('[red-index] deriveCategoriesFromRows failed', e);
}
const merged = mergeSheetCategories('red', sheetCategories) || CHANNEL_MAP.red;
const categories = Object.entries(merged.subs).map(([slug, cat]) => ({
  slug, label: cat.kr, labelEn: cat.en, free: !!cat.free,
}));
const freeN = categories.filter((c) => c.free).length;
const paidN = categories.length - freeN;
const color = '#E1261C';
---
<Layout title="taerijay+red | TAERIJAY">
  <div class="channel-page" style={`--c:${color}`}>
    <div class="channel-topbar">
      <button type="button" class="back-btn" onclick="history.back()">← 뒤로가기</button>
    </div>

    <HeroSlider slides={heroSlides} color={color} />

    <section class="channel-hero">
      <span class="channel-badge channel-badge-lock notranslate" translate="no">무료 {freeN}개 + 유료 {paidN}개 · 총 {categories.length}개 카테고리</span>
      <span class="channel-category">BEAUTY</span>
      <h1 class="channel-title">taerijay<span style={`color:${color}`}>+red</span></h1>
      <p class="channel-sub">균일가 생활용품점 뷰티 대란템 정리 DB, 매장 위치 정보. 100개 고정, 월 2회(10일·20일) 리뉴얼</p>
      <a href="/pricing" class="channel-subscribe-btn">구독하기 · Subscribe</a>
    </section>

    {categories.length > 0 && (
      <section class="cat-grid-section">
        {categories.map((cat) => (
          <a href={`/04-channels/red/${cat.slug}`} class="cat-card">
            <div class="cat-card-art">
              <span class={`cat-card-tier notranslate ${cat.free ? 'is-free' : 'is-paid'}`} translate="no">{cat.free ? 'FREE' : 'PAID'}</span>
              <span class="cat-card-name notranslate" translate="no">{cat.label}</span>
              <span class="cat-card-name-en">{cat.labelEn}</span>
            </div>
          </a>
        ))}
      </section>
    )}

    {categories.length === 0 && (
      <section class="empty-note">
        <p>콘텐츠 준비 중</p>
        <p class="empty-note-en">Content coming soon.</p>
      </section>
    )}
  </div>
</Layout>
