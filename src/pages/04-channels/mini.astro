---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import HeroSlider from '../../components/HeroSlider.astro';
import { CHANNEL_MAP, mergeSheetCategories } from '../../lib/channelCategories.js';
import { fetchChannelRows, deriveCategoriesFromRows } from '../../lib/sheetsCms.js';
import '../../styles/channel-page.css';

// 한국 지도 + 지역별 여행 컨셉 — 실제 이미지는 img 필드에 추후 URL만 채워넣으면 자동 반영됨(현재는 그라디언트 대체)
const heroSlides = [
  { titleKr: '서울에서 시작하는 3시간 코스', titleEn: 'Seoul in 3 Hours', dateLabel: 'SEOUL', img: '/images/channels/mini/hero-1.png' },
  { titleKr: '부산·경주, 남쪽으로 떠나는 여행', titleEn: 'Busan & Gyeongju Trip', dateLabel: 'GYEONGSANG', img: '/images/channels/mini/hero-2.png' },
  { titleKr: '제주부터 강원까지, 전국 큐레이션', titleEn: 'Nationwide Curated Routes', dateLabel: 'ALL REGIONS', img: '/images/channels/mini/hero-3.png' },
];

// 카드 하단 부가설명("지역 내부" 등)은 시트 컬럼으로 표현하지 않는 순수 UI 문구라 코드에 유지.
// 카테고리 자체(이름/무료여부/추가·삭제)는 시트(sub/sub_kr/sub_en/sub_free 컬럼)에서 자동 도출.
const SUB_HINTS = {
  'half-day': '지역 내부',
  '1day': '지역 내부',
  '2day': '타 지역 포함',
  '3day': '타 지역 포함',
  region: '타 지역 포함',
  recommend: '지역 × 카테고리',
  kdrama: '단독 목록',
  nightview: '지역 × 카테고리',
  photo: '지역 × 카테고리',
  indoor: '지역 × 카테고리',
};

let allRows = [];
try {
  allRows = await fetchChannelRows('mini');
} catch (e) {
  console.error('[mini-index] sheet fetch failed', e);
}
let sheetCategories = [];
try {
  sheetCategories = deriveCategoriesFromRows(allRows);
} catch (e) {
  console.error('[mini-index] deriveCategoriesFromRows failed', e);
}
const merged = mergeSheetCategories('mini', sheetCategories) || CHANNEL_MAP.mini;
const tabs = Object.entries(merged.subs).map(([slug, cat]) => ({
  slug, label: cat.kr, labelEn: cat.en, free: !!cat.free, sub: SUB_HINTS[slug] || '',
}));
const freeN = tabs.filter((t) => t.free).length;
const paidN = tabs.length - freeN;
const color = '#e8e4dc';
---
<Layout title="taerijay+mini | TAERIJAY">
  <div class="channel-page" style={`--c:${color}`}>
    <div class="channel-topbar">
      <button type="button" class="back-btn" onclick="history.back()">← 뒤로가기</button>
    </div>

    <HeroSlider slides={heroSlides} color={color} />

    <section class="channel-hero">
      <span class="channel-badge channel-badge-lock notranslate" translate="no">무료 {freeN}개 + 유료 {paidN}개 · 총 {tabs.length}개 카테고리</span>
      <h1 class="channel-title">taerijay<span style={`color:${color}`}>+mini</span></h1>
      <p class="channel-sub">거점 도시별 최적 동선, 시간대별 큐레이션 코스. 100→1,000개 누적, 매월 10일·20일 업데이트</p>
      <a href="/pricing" class="channel-subscribe-btn">구독하기 · Subscribe</a>
    </section>

    {tabs.length > 0 && (
      <section class="cat-grid-section">
        {tabs.map((tab) => (
          <a href={`/04-channels/mini/${tab.slug}`} class="cat-card">
            <div class="cat-card-art">
              <span class={`cat-card-tier notranslate ${tab.free ? 'is-free' : 'is-paid'}`} translate="no">{tab.free ? 'FREE' : 'PAID'}</span>
              <span class="cat-card-name notranslate" translate="no">{tab.label}</span>
              <span class="cat-card-name-en">{tab.labelEn}</span>
              {tab.sub && <span class="cat-card-sub notranslate" translate="no">{tab.sub}</span>}
            </div>
          </a>
        ))}
      </section>
    )}

    {tabs.length === 0 && (
      <section class="empty-note">
        <p>콘텐츠 준비 중</p>
        <p class="empty-note-en">Content coming soon.</p>
      </section>
    )}
  </div>
</Layout>
