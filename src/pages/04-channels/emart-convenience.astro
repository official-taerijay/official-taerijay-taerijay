---
import Layout from '../../layouts/Layout.astro';

const brands = [
  { slug: 'emart',       label: '이마트',     labelEn: 'E-Mart',    sub: '무료 5 · 유료 25' },
  { slug: 'nobrand',     label: '노브랜드',    labelEn: 'No Brand',  sub: '무료 5 · 유료 25' },
  { slug: 'traders',     label: '트레이더스',  labelEn: 'Traders',   sub: '무료 5 · 유료 25' },
  { slug: 'emart24',     label: '이마트24',    labelEn: 'emart24',   sub: '무료 5 · 유료 25' },
  { slug: 'cu',          label: 'CU',          labelEn: 'CU',        sub: '무료 5 · 유료 25' },
  { slug: 'gs25',        label: 'GS25',        labelEn: 'GS25',      sub: '무료 5 · 유료 25' },
  { slug: 'seveneleven', label: '세븐일레븐',  labelEn: '7-Eleven',  sub: '무료 5 · 유료 25' },
];
const extras = [
  { slug: 'taxfree-instant', label: '매장 즉시 세금환급', labelEn: 'Instant Tax Refund', free: true },
  { slug: 'gender-care',     label: '남성용품·여성용품',   labelEn: 'Men & Women Care' },
];
const color = '#FFDD00';
---
<Layout title="taerijay+emart+convenience | TAERIJAY" requireChannel="emart_cvs">
  <div class="channel-page" style={`--c:${color}`}>
    <div class="channel-topbar">
      <button type="button" class="back-btn" onclick="history.back()">← 뒤로가기</button>
    </div>

    <section class="channel-hero-banner" style={`--hero-img:url('/images/channels/emart.jpg');--c:${color}`}>
      <span class="channel-hero-region">
        <span class="channel-hero-region-kr">제주</span>
        <span class="channel-hero-region-en" data-i18n="en">JEJU</span>
      </span>
    </section>

    <section class="channel-hero">
      <span class="channel-badge channel-badge-lock">7개 브랜드 · 브랜드별 TOP 30 (무료 5 + 유료 25)</span>
      <span class="channel-category">SHOPPING</span>
      <h1 class="channel-title">taerijay<span style={`color:${color}`}>+emart+convenience</span></h1>
      <p class="channel-sub">이마트·노브랜드·트레이더스·이마트24·CU·GS25·세븐일레븐 핫템 랭킹. 브랜드별 100개 고정, 월 2회(10일·20일) 리뉴얼</p>
      <a href="/pricing" class="channel-subscribe-btn">구독하기 · Subscribe</a>
    </section>

    <section class="cat-grid-section">
      {brands.map((b) => (
        <a href={`/04-channels/emart-convenience/${b.slug}`} class="cat-card">
          <div class="cat-card-art">
            <span class="cat-card-name">{b.label}</span>
            <span class="cat-card-name-en">{b.labelEn}</span>
            <span class="cat-card-sub">{b.sub}</span>
          </div>
        </a>
      ))}
      {extras.map((cat) => (
        <a href={`/04-channels/emart-convenience/${cat.slug}`} class="cat-card">
          <div class="cat-card-art">
            <span class={`cat-card-tier ${cat.free ? 'is-free' : 'is-paid'}`}>{cat.free ? '무료' : '유료'}</span>
            <span class="cat-card-name">{cat.label}</span>
            <span class="cat-card-name-en">{cat.labelEn}</span>
          </div>
        </a>
      ))}
    </section>

    <section class="empty-note">
      <p>콘텐츠 준비 중입니다.</p>
      <p class="empty-note-en">Content coming soon.</p>
    </section>
  </div>

  <style>
    .channel-page{width:var(--container);margin:0 auto;padding:24px 0 60px}
    .channel-topbar{margin-bottom:20px;padding-top:88px}
    .back-btn{background:transparent;border:1px solid rgba(255,255,255,.2);color:var(--ivory);font-size:.8rem;font-weight:600;padding:8px 16px;border-radius:100px;cursor:pointer;transition:background .2s}
    .back-btn:hover{background:rgba(255,255,255,.1)}

    .channel-hero-banner{position:relative;width:100%;aspect-ratio:21/9;border-radius:18px;overflow:hidden;margin-bottom:28px;background-image:var(--hero-img, none), linear-gradient(160deg, color-mix(in srgb, var(--c) 30%, var(--bg)) 0%, var(--bg) 100%);background-size:cover;background-position:center;border:1px solid color-mix(in srgb, var(--c) 30%, transparent)}
    .channel-hero-banner::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(6,10,18,.85) 100%)}
    .channel-hero-region{position:absolute;left:20px;bottom:16px;z-index:1;display:flex;flex-direction:column;gap:1px}
    .channel-hero-region-kr{font-family:var(--f-display);font-weight:900;font-size:1.1rem;color:var(--ivory)}
    .channel-hero-region-en{font-size:.86rem;letter-spacing:.12em;font-weight:700;color:var(--c);text-transform:uppercase}
    @media (max-width:560px){.channel-hero-banner{aspect-ratio:16/9}}

    .channel-hero{padding-bottom:28px;border-bottom:1px solid color-mix(in srgb, var(--c) 30%, transparent);margin-bottom:36px}
    .channel-badge{display:inline-block;background:var(--gold);color:var(--bg);font-size:.68rem;font-weight:800;letter-spacing:.04em;padding:5px 14px;border-radius:100px;margin-bottom:12px;margin-right:8px}
    .channel-badge-lock{background:color-mix(in srgb, var(--c) 16%, transparent);color:var(--c);border:1px solid color-mix(in srgb, var(--c) 40%, transparent)}
    .channel-category{display:inline-block;font-size:.68rem;letter-spacing:.14em;color:var(--dim);font-weight:700;margin-bottom:16px;text-transform:uppercase}
    .channel-title{font-family:var(--f-display);font-weight:900;font-size:clamp(1.5rem,4.6vw,2.4rem);margin-bottom:10px}
    .channel-sub{font-size:.88rem;color:var(--muted);max-width:52ch;line-height:1.6}
    .channel-subscribe-btn{display:inline-block;margin-top:16px;text-decoration:none;background:var(--c);color:var(--bg);font-weight:800;font-size:.82rem;letter-spacing:.02em;padding:11px 22px;border-radius:8px}

    .cat-grid-section{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;margin-bottom:40px}
    .cat-card{text-decoration:none;color:var(--ivory);display:block;border:1px solid color-mix(in srgb, var(--c) 40%, transparent);border-radius:14px;overflow:hidden;transition:transform .2s ease}
    .cat-card:hover{transform:translateY(-4px)}
    .cat-card-art{position:relative;aspect-ratio:16/9;background:linear-gradient(160deg, color-mix(in srgb, var(--c) 18%, var(--bg)) 0%, var(--bg) 80%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;padding:12px}
    .cat-card-name{font-family:var(--f-display);font-weight:900;font-size:clamp(1.1rem,3.4vw,1.4rem);color:var(--c);text-align:center}
    .cat-card-name-en{font-size:.9rem;letter-spacing:.06em;color:var(--muted);text-transform:uppercase}
    .cat-card-sub{font-size:.68rem;color:var(--dim);margin-top:4px}
    .cat-card-tier{position:absolute;top:10px;right:10px;font-size:.62rem;font-weight:800;letter-spacing:.04em;padding:3px 9px;border-radius:100px}
    .cat-card-tier.is-free{background:rgba(120,220,140,.16);color:#7ee0a0;border:1px solid rgba(120,220,140,.4)}
    .cat-card-tier.is-paid{background:color-mix(in srgb, var(--c) 18%, transparent);color:var(--c);border:1px solid color-mix(in srgb, var(--c) 40%, transparent)}

    .empty-note{text-align:center;padding:40px 20px;border:1px dashed rgba(255,255,255,.15);border-radius:14px}
    .empty-note p{font-size:.88rem;color:var(--muted);margin-bottom:6px}
    .empty-note-en{font-size:.94rem;color:var(--dim)}

    @media (max-width: 560px){
      .cat-grid-section{grid-template-columns:repeat(2,1fr)}
    }
  </style>
</Layout>
