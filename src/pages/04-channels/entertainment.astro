---
import Layout from '../../layouts/Layout.astro';
import '../../styles/channel-page.css';

const categories = [
  { slug: 'drama', label: '드라마', labelEn: 'Drama' },
  { slug: 'movie', label: '영화', labelEn: 'Movie' },
];
const color = '#00E5FF';
---
<Layout title="taerijay+entertainment | TAERIJAY">
  <div class="channel-page" style={`--c:${color}`}>
    <div class="channel-topbar">
      <button type="button" class="back-btn" onclick="history.back()">← 뒤로가기</button>
    </div>

    <section class="channel-hero-banner" style={`--hero-img:url('/images/channels/entertainment.jpg');--c:${color}`}>
    </section>

    <section class="channel-hero">
      <span class="channel-badge notranslate" translate="no">무료 이용</span>
      <h1 class="channel-title">taerijay<span style={`color:${color}`}>+entertainment</span></h1>
      <p class="channel-sub">K-콘텐츠 촬영지·팬 성지 총정리, 전체 무료</p>
    </section>

    <section class="cat-grid-section">
      {categories.map((cat) => (
        <a href={`/04-channels/entertainment/${cat.slug}`} class="cat-card">
          <div class="cat-card-art">
            <span class="cat-card-name notranslate" translate="no">{cat.label}</span>
            <span class="cat-card-name-en">{cat.labelEn}</span>
          </div>
        </a>
      ))}
    </section>

    <section class="empty-note">
      <p>콘텐츠 준비 중입니다.</p>
      <p class="empty-note-en">Content coming soon.</p>
    </section>
  </div>
</Layout>