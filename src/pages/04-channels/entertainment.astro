---
import Layout from '../../layouts/Layout.astro';
import HeroSlider from '../../components/HeroSlider.astro';
import '../../styles/channel-page.css';

const categories = [
  { slug: 'drama', label: '드라마', labelEn: 'Drama' },
  { slug: 'movie', label: '영화', labelEn: 'Movie' },
  { slug: 'variety', label: '예능', labelEn: 'Variety' },
];
const color = '#00E5FF';

// 아이돌 공연/무대 컨셉 — 실제 이미지는 img 필드에 추후 URL만 채워넣으면 자동 반영됨(현재는 그라디언트 대체)
const heroSlides = [
  { titleKr: '무대 위, 지금 이 순간', titleEn: 'On Stage, Right Now', dateLabel: 'K-POP LIVE', img: '/images/channels/entertainment/hero-1.png' },
  { titleKr: '오늘 밤, 다시 보는 인기 드라마', titleEn: 'Tonight’s Must-Watch Drama', dateLabel: 'K-DRAMA', img: '/images/channels/entertainment/hero-2.png' },
  { titleKr: '스크린 속 새로운 이야기', titleEn: 'New Stories on Screen', dateLabel: 'K-MOVIE', img: '/images/channels/entertainment/hero-3.png' },
];
---
<Layout title="taerijay+entertainment | TAERIJAY">
  <div class="channel-page" style={`--c:${color}`}>
    <div class="channel-topbar">
      <button type="button" class="back-btn" onclick="history.back()">← 뒤로가기</button>
    </div>

    <HeroSlider slides={heroSlides} color={color} />

    <section class="channel-hero">
      <span class="channel-badge notranslate" translate="no">무료 이용</span>
      <h1 class="channel-title">taerijay<span style={`color:${color}`}>+entertainment</span></h1>
      <p class="channel-sub">K-콘텐츠 촬영지·팬 성지 총정리, 전체 무료</p>
      <div class="channel-search">
        <svg class="channel-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" id="channelSearchInput" class="channel-search-input" placeholder="드라마·영화·예능 검색 / Search drama, movie, variety" autocomplete="off" />
        <button type="button" id="channelSearchClear" class="channel-search-clear" hidden aria-label="검색어 지우기">×</button>
      </div>
    </section>

    <section class="cat-grid-section" id="catGrid">
      {categories.map((cat) => (
        <a href={`/04-channels/entertainment/${cat.slug}`} class="cat-card" data-search={`${cat.label} ${cat.labelEn}`.toLowerCase()}>
          <div class="cat-card-art">
            <span class="cat-card-tier is-free notranslate" translate="no">FREE</span>
            <span class="cat-card-name notranslate" translate="no">{cat.label}</span>
            <span class="cat-card-name-en">{cat.labelEn}</span>
          </div>
        </a>
      ))}
    </section>

    <p class="channel-search-empty" id="channelSearchEmpty" hidden>
      <span>검색 결과가 없어요</span>
      <span class="channel-search-empty-en">No results found</span>
    </p>

    <section class="empty-note">
      <p>콘텐츠 준비 중</p>
      <p class="empty-note-en">Content coming soon.</p>
    </section>
  </div>

  <script>
    const input = document.getElementById('channelSearchInput');
    const clearBtn = document.getElementById('channelSearchClear');
    const grid = document.getElementById('catGrid');
    const emptyNote = document.getElementById('channelSearchEmpty');
    if (input && grid) {
      const cards = Array.from(grid.querySelectorAll('[data-search]'));
      const runFilter = () => {
        const q = input.value.trim().toLowerCase();
        clearBtn.hidden = q.length === 0;
        let visible = 0;
        cards.forEach((card) => {
          const match = !q || card.getAttribute('data-search').includes(q);
          card.hidden = !match;
          if (match) visible++;
        });
        if (emptyNote) emptyNote.hidden = !(q && visible === 0);
      };
      input.addEventListener('input', runFilter);
      clearBtn.addEventListener('click', () => { input.value = ''; runFilter(); input.focus(); });
    }
  </script>
</Layout>