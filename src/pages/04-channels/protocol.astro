---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import HeroSlider from '../../components/HeroSlider.astro';
import { CHANNEL_MAP, mergeSheetCategories } from '../../lib/channelCategories.js';
import { fetchChannelRows, deriveCategoriesFromRows } from '../../lib/sheetsCms.js';
import '../../styles/channel-page.css';

// 서울 야경(광화문·남대문) 컨셉 — 실제 이미지는 img 필드에 추후 URL만 채워넣으면 자동 반영됨(현재는 그라디언트 대체)
const heroSlides = [
  { titleKr: '광화문의 밤, 서울의 첫인상', titleEn: 'Gwanghwamun by Night', dateLabel: 'SEOUL AT NIGHT', img: '/images/channels/protocol/hero-1.png' },
  { titleKr: '공항에서 시내까지, 완벽 가이드', titleEn: 'Airport to City Guide', dateLabel: 'TRAVEL PROTOCOL', img: '/images/channels/protocol/hero-2.png' },
  { titleKr: '현지인만 아는 맛집·카페', titleEn: 'Local Favorites', dateLabel: 'RESTAURANT & CAFE', img: '/images/channels/protocol/hero-3.png' },
];

// 카테고리 목록은 코드에 하드코딩하지 않고 시트(sub/sub_kr/sub_en/sub_free/sub_order 컬럼)에서 자동 도출.
// 시트에 새 sub 값을 가진 행을 추가하면 카테고리가 자동 생성되고, 항목이 하나도 없어지면 사라진다.
let allRows = [];
try {
  allRows = await fetchChannelRows('protocol');
} catch (e) {
  console.error('[protocol-index] sheet fetch failed', e);
}
let sheetCategories = [];
try {
  sheetCategories = deriveCategoriesFromRows(allRows);
} catch (e) {
  console.error('[protocol-index] deriveCategoriesFromRows failed', e);
}
const merged = mergeSheetCategories('protocol', sheetCategories) || CHANNEL_MAP.protocol;
const categories = Object.entries(merged.subs).map(([slug, cat]) => ({
  slug, label: cat.kr, labelEn: cat.en, free: !!cat.free,
}));
const freeN = categories.filter((c) => c.free).length;
const paidN = categories.length - freeN;
const color = '#F16B24';
---
<Layout title="taerijay+protocol | TAERIJAY">
  <div class="channel-page" style={`--c:${color}`}>
    <div class="channel-topbar">
      <button type="button" class="back-btn" onclick="history.back()">← 뒤로가기</button>
    </div>

    <HeroSlider slides={heroSlides} color={color} />

    <section class="channel-hero">
      <span class="channel-badge channel-badge-lock notranslate" translate="no">무료 {freeN}개 + 유료 {paidN}개 · 총 {categories.length}개 카테고리</span>
      <h1 class="channel-title">taerijay<span style={`color:${color}`}>+protocol</span></h1>
      <p class="channel-sub">공항·세관·대중교통 규약부터 맛집·카페까지, 검증된 현지 정보. 매월 10일·20일 업데이트</p>
      <a href="/pricing" class="channel-subscribe-btn">구독하기 · Subscribe</a>
      {categories.length > 0 && (
        <div class="channel-search">
          <svg class="channel-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="text" id="channelSearchInput" class="channel-search-input" placeholder="카테고리 검색 / Search categories" autocomplete="off" />
          <button type="button" id="channelSearchClear" class="channel-search-clear" hidden aria-label="검색어 지우기">×</button>
        </div>
      )}
    </section>

    {categories.length > 0 && (
      <section class="cat-grid-section" id="catGrid">
        {categories.map((cat) => (
          <a href={`/04-channels/protocol/${cat.slug}`} class="cat-card" data-search={`${cat.label} ${cat.labelEn}`.toLowerCase()}>
            <div class="cat-card-art">
              <span class={`cat-card-tier notranslate ${cat.free ? 'is-free' : 'is-paid'}`} translate="no">{cat.free ? 'FREE' : 'PAID'}</span>
              <span class="cat-card-name notranslate" translate="no">{cat.label}</span>
              <span class="cat-card-name-en">{cat.labelEn}</span>
            </div>
          </a>
        ))}
      </section>
    )}

    {categories.length > 0 && (
      <p class="channel-search-empty" id="channelSearchEmpty" hidden>
        <span>검색 결과가 없어요</span>
        <span class="channel-search-empty-en">No results found</span>
      </p>
    )}

    {categories.length === 0 && (
      <section class="empty-note">
        <p>콘텐츠 준비 중</p>
        <p class="empty-note-en">Content coming soon.</p>
      </section>
    )}
  </div>

  {categories.length > 0 && (
    <script>
      const input = document.getElementById('channelSearchInput');
      const clearBtn = document.getElementById('channelSearchClear');
      const grid = document.getElementById('catGrid');
      const emptyNote = document.getElementById('channelSearchEmpty');
      if (input && grid) {
        const cards = Array.from(grid.querySelectorAll('[data-search]'));
        const runFilter = () => {
          const q = input.value.trim().toLowerCase();
          clearBtn.hidden = q.length === 0;
          let visible = 0;
          cards.forEach((card) => {
            const match = !q || card.getAttribute('data-search').includes(q);
            card.hidden = !match;
            if (match) visible++;
          });
          if (emptyNote) emptyNote.hidden = !(q && visible === 0);
        };
        input.addEventListener('input', runFilter);
        clearBtn.addEventListener('click', () => { input.value = ''; runFilter(); input.focus(); });
      }
    </script>
  )}
</Layout>