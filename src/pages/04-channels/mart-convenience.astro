---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import HeroSlider from '../../components/HeroSlider.astro';
import { CHANNEL_MAP, mergeSheetCategories } from '../../lib/channelCategories.js';
import { fetchChannelRows, deriveCategoriesFromRows } from '../../lib/sheetsCms.js';
import '../../styles/channel-page.css';

// 대형마트 쇼핑 + 편의점 굿즈 컨셉 — 실제 이미지는 img 필드에 추후 URL만 채워넣으면 자동 반영됨(현재는 그라디언트 대체)
const heroSlides = [
  { titleKr: '대형마트 진열대, 오늘의 핫템', titleEn: "Today's Hot Picks", dateLabel: 'E-MART · TRADERS', img: '/images/channels/mart-convenience/hero-1.png' },
  { titleKr: '편의점 한정 굿즈, 놓치면 후회', titleEn: 'Limited Convenience Store Goods', dateLabel: 'CU · GS25 · 7-ELEVEN', img: '/images/channels/mart-convenience/hero-2.png' },
  { titleKr: '즉시 세금환급으로 더 알뜰하게', titleEn: 'Instant Tax Refund', dateLabel: 'TAX FREE', img: '/images/channels/mart-convenience/hero-3.png' },
];

// 7개 브랜드(emart/nobrand/traders/emart24/cu/gs25/seveneleven)는 "브랜드별 TOP30(무료5+유료25)"라는
// 고정 구조라 브랜드 카드 자체는 코드에 유지. 그 외 순수 카테고리(세금환급, 젠더케어 등)는
// 시트(sub/sub_kr/sub_en/sub_free 컬럼)에서 자동 도출 — 시트에 새 sub를 추가하면 새 카테고리가 자동 생김.
const BRAND_SLUGS = ['emart', 'nobrand', 'traders', 'emart24', 'cu', 'gs25', 'seveneleven'];
const BRAND_LABELS = {
  emart: { kr: '이마트', en: 'E-Mart' },
  nobrand: { kr: '노브랜드', en: 'No Brand' },
  traders: { kr: '트레이더스', en: 'Traders' },
  emart24: { kr: '이마트24', en: 'emart24' },
  cu: { kr: 'CU', en: 'CU' },
  gs25: { kr: 'GS25', en: 'GS25' },
  seveneleven: { kr: '세븐일레븐', en: '7-Eleven' },
};

let allRows = [];
try {
  allRows = await fetchChannelRows('mart-convenience');
} catch (e) {
  console.error('[mart-convenience-index] sheet fetch failed', e);
}
let sheetCategories = [];
try {
  sheetCategories = deriveCategoriesFromRows(allRows);
} catch (e) {
  console.error('[mart-convenience-index] deriveCategoriesFromRows failed', e);
}
const merged = mergeSheetCategories('mart-convenience', sheetCategories) || CHANNEL_MAP['mart-convenience'];

const brands = BRAND_SLUGS.map((slug) => {
  const overrideLabel = merged.subs[slug];
  return {
    slug,
    label: BRAND_LABELS[slug].kr,
    labelEn: BRAND_LABELS[slug].en,
    sub: overrideLabel?.freeCount ? `무료 ${overrideLabel.freeCount} · 유료 ${25}` : '무료 5 · 유료 25',
  };
});

const extras = Object.entries(merged.subs)
  .filter(([slug]) => !BRAND_SLUGS.includes(slug))
  .map(([slug, cat]) => ({ slug, label: cat.kr, labelEn: cat.en, free: !!cat.free }));

const color = '#FFDD00';
---
<Layout title="taerijay+mart+convenience | TAERIJAY">
  <div class="channel-page" style={`--c:${color}`}>
    <div class="channel-topbar">
      <button type="button" class="back-btn" onclick="history.back()">← 뒤로가기</button>
    </div>

    <HeroSlider slides={heroSlides} color={color} />

    <section class="channel-hero">
      <span class="channel-badge channel-badge-lock notranslate" translate="no">7개 브랜드 · 브랜드별 TOP 30 (무료 5 + 유료 25)</span>
      <span class="channel-category">SHOPPING</span>
      <h1 class="channel-title">taerijay<span style={`color:${color}`}>+mart+convenience</span></h1>
      <p class="channel-sub">대형마트·편의점 7개 브랜드 핫템 랭킹. 브랜드별 100개 고정, 매월 10일·20일 업데이트</p>
      <a href="/pricing" class="channel-subscribe-btn">구독하기 · Subscribe</a>
    </section>

    <section class="cat-grid-section">
      {brands.map((b) => (
        <a href={`/04-channels/mart-convenience/${b.slug}`} class="cat-card">
          <div class="cat-card-art">
            <span class="cat-card-tier cat-card-tier-mixed notranslate" translate="no">FREE + PAID</span>
            <span class="cat-card-name notranslate" translate="no">{b.label}</span>
            <span class="cat-card-name-en">{b.labelEn}</span>
            <span class="cat-card-sub notranslate" translate="no">{b.sub}</span>
          </div>
        </a>
      ))}
      {extras.map((cat) => (
        <a href={`/04-channels/mart-convenience/${cat.slug}`} class="cat-card">
          <div class="cat-card-art">
            <span class={`cat-card-tier notranslate ${cat.free ? 'is-free' : 'is-paid'}`} translate="no">{cat.free ? 'FREE' : 'PAID'}</span>
            <span class="cat-card-name notranslate" translate="no">{cat.label}</span>
            <span class="cat-card-name-en">{cat.labelEn}</span>
          </div>
        </a>
      ))}
    </section>

    <section class="empty-note">
      <p>콘텐츠 준비 중</p>
      <p class="empty-note-en">Content coming soon.</p>
    </section>
  </div>
</Layout>
