---
const FIREBASE_API_KEY = "AIzaSyDohULKEyCcSi30UpbLJSwPwHJ0Vad8J5M";
const FIREBASE_AUTH_DOMAIN = "taerijay-official.firebaseapp.com";
const FIREBASE_PROJECT_ID = "taerijay-official";
import { languages } from '../../lib/languages.js';
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <title>TAERIJAY</title>
</head>
<body>
  <div id="splash" class="splash"><span class="splash-brand notranslate" translate="no">TAERIJAY</span></div>
  <div class="app">
    <header class="header">
      <a href="/" class="header-logo notranslate" translate="no">TAERIJAY</a>
      <div class="header-right">
        <button type="button" class="header-back-btn" id="auth-back-btn" aria-label="뒤로가기">←</button>
        <div class="header-lang-dropdown">
          <button type="button" class="header-lang-trigger" id="auth-lang-trigger">
            <span id="auth-lang-current">한국어</span>
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <div class="header-lang-menu" id="auth-lang-menu" hidden>
            {languages.map((l) => (
              <button type="button" class="header-lang-option" data-code={l.code} data-name={l.name}>{l.name}</button>
            ))}
          </div>
        </div>
      </div>
    </header>

    <main class="main">
      <div class="status-panel" id="statusPanel" hidden>
        <p class="status-kr notranslate" translate="no">로그인 완료</p>
        <p class="status-en">You're signed in</p>
        <p class="status-email" id="statusEmail"></p>
        <button type="button" class="btn-signout" id="btn-signout" hidden>
          <span class="btn-kr notranslate" translate="no">로그아웃</span>
          <span class="btn-en">Log Out</span>
        </button>
      </div>

      <button type="button" class="btn-open-modal" id="btn-signin">
        <span class="btn-kr notranslate" translate="no">회원가입 / 로그인</span>
        <span class="btn-en">Sign Up / Log In</span>
      </button>
    </main>
  </div>

  <div class="modal" id="auth-modal" hidden>
    <div class="modal-card">
      <button type="button" class="modal-close" id="modal-close-btn">×</button>
      <h1 class="modal-brand notranslate" translate="no">TAERIJAY</h1>
      <p class="modal-sub-kr notranslate" translate="no">구글 계정 로그인, 전 채널 콘텐츠 확인</p>
      <p class="modal-sub-en" data-i18n="en">Sign in with Google — unlock all channels</p>
      <button class="btn-google" id="google-btn">
        <svg width="20" height="20" viewBox="0 0 18 18"><path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.9c1.7-1.57 2.7-3.88 2.7-6.62z"/><path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.9-2.26c-.8.54-1.84.86-3.06.86-2.35 0-4.34-1.59-5.05-3.72H.95v2.33A9 9 0 0 0 9 18z"/><path fill="#FBBC05" d="M3.95 10.7A5.4 5.4 0 0 1 3.66 9c0-.59.1-1.17.29-1.7V4.97H.95A9 9 0 0 0 0 9c0 1.45.35 2.83.95 4.03l3-2.33z"/><path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .95 4.97l3 2.33C4.66 5.17 6.65 3.58 9 3.58z"/></svg>
        <span class="btn-google-kr notranslate" translate="no">Google로 로그인</span>
        <span class="btn-google-en" data-i18n="en">Sign in with Google</span>
      </button>
      <div id="login-error" style="display:none;margin-top:12px;color:#F16B24;font-size:.82rem;text-align:left;">
        <span class="err-kr notranslate" translate="no">로그인 실패, 재시도 필요</span>
        <span class="err-en">Sign-in failed — try again</span>
        <div id="login-error-detail" style="margin-top:6px;font-size:.7rem;color:var(--dim);word-break:break-all;"></div>
      </div>
    </div>
  </div>

  <style>
    :root{--bg:#0A192F;--border:#5B0E1B;--fg:#FBF9F4;--ivory:#FBF9F4;--muted:#8b96a8;--dim:#6b7789;--f-display:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",Roboto,Helvetica,Arial,sans-serif;--f-body:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Roboto,Helvetica,Arial,sans-serif}
    *{box-sizing:border-box;margin:0;padding:0}
    html,body{background:var(--bg);color:var(--fg);font-family:var(--f-body);min-height:100vh}
    .splash{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;z-index:999;transition:opacity .5s}
    .splash-brand{font-family:var(--f-display);font-weight:900;font-size:2rem;color:#B33A52}
    .header{padding:20px 24px;display:flex;align-items:center;justify-content:space-between}
    .header-logo{font-family:var(--f-display);font-weight:900;font-size:1.15rem;color:#B33A52;text-decoration:none}
    .header-right{display:flex;align-items:center;gap:8px}
    .header-back-btn{background:transparent;border:1px solid rgba(255,255,255,.2);color:var(--fg);font-size:.9rem;line-height:1;padding:8px 11px;border-radius:6px;cursor:pointer}
    .header-back-btn:hover{background:rgba(255,255,255,.1)}
    .header-lang-dropdown{position:relative}
    .header-lang-trigger{display:flex;align-items:center;gap:6px;background:transparent;border:1px solid rgba(255,255,255,.2);color:var(--fg);font-size:.72rem;font-weight:600;padding:8px 11px;border-radius:6px;cursor:pointer}
    .header-lang-menu{position:absolute;top:calc(100% + 8px);right:0;background:#151f33;border:1px solid rgba(255,255,255,.12);border-radius:10px;box-shadow:0 16px 40px rgba(0,0,0,.5);max-height:280px;overflow-y:auto;min-width:160px;z-index:501}
    .header-lang-option{display:block;width:100%;text-align:left;background:transparent;border:none;color:var(--fg);font-size:.78rem;padding:9px 14px;cursor:pointer}
    .header-lang-option:hover{background:rgba(255,255,255,.08)}
    .main{max-width:480px;margin:0 auto;padding:20px 24px 80px;display:flex;flex-direction:column;align-items:flex-start;gap:20px;text-align:left}

    .btn-open-modal{width:100%;background:#B33A52;color:var(--fg);border:none;border-radius:10px;padding:16px;cursor:pointer;display:flex;flex-direction:column;gap:2px;margin-top:40px}
    .btn-open-modal[hidden]{display:none!important}
    .btn-open-modal .btn-kr{font-weight:700;font-size:clamp(.86rem,2.2vw,1.05rem)}
    .btn-open-modal .btn-en{font-size:clamp(.86rem,2.2vw,1.05rem);opacity:.85}

    .status-panel{width:100%;border:1px solid rgba(255,255,255,.15);border-radius:12px;padding:24px;margin-top:40px;display:flex;flex-direction:column;gap:6px;align-items:flex-start}
    .status-panel[hidden]{display:none!important}
    .status-kr{font-weight:700;font-size:clamp(.9rem,2.4vw,1.15rem);color:var(--dim)}
    .status-en{font-size:clamp(.9rem,2.4vw,1.15rem);color:var(--ivory)}
    .status-email{font-size:.8rem;color:var(--dim);margin-top:8px}
    .btn-signout{margin-top:16px;background:rgba(91,14,27,.55);border:1px solid #8B1A2A;color:var(--fg);border-radius:8px;padding:10px 20px;cursor:pointer;display:flex;flex-direction:column;gap:1px}
    .btn-signout[hidden]{display:none!important}
    .btn-signout .btn-kr{font-weight:700;font-size:clamp(.76rem,2vw,.9rem)}
    .btn-signout .btn-en{font-size:clamp(.76rem,2vw,.9rem);color:var(--muted)}

    .modal{position:fixed;inset:0;background:rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;z-index:500;padding:20px}
    .modal[hidden]{display:none!important}
    .modal-card{position:relative;width:100%;max-width:400px;background:var(--bg);border:1px solid #8B1A2A;border-radius:16px;padding:36px 28px;text-align:left}
    .modal-close{position:absolute;top:14px;right:16px;background:none;border:none;color:var(--muted);font-size:1.6rem;cursor:pointer;line-height:1}
    .modal-brand{font-family:var(--f-display);font-weight:900;font-size:1.5rem;color:#B33A52;margin-bottom:20px}
    .modal-sub-kr{font-size:clamp(.78rem,2vw,.94rem);color:var(--muted);line-height:1.6;margin-bottom:4px}
    .modal-sub-en{font-size:clamp(.78rem,2vw,.94rem);color:var(--ivory);line-height:1.5;margin-bottom:24px}
    .btn-google{width:100%;display:flex;align-items:center;justify-content:flex-start;gap:10px;background:var(--fg);color:var(--bg);border:none;border-radius:10px;padding:13px;font-family:var(--f-body);font-weight:700;font-size:.92rem;cursor:pointer}
    .btn-google-kr,.btn-google-en{white-space:nowrap}
  </style>

  <script type="module" define:vars={{ FIREBASE_API_KEY, FIREBASE_AUTH_DOMAIN, FIREBASE_PROJECT_ID }}>
    import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js';
    import { getAuth, GoogleAuthProvider, signInWithPopup, signInWithRedirect, getRedirectResult, signOut, onAuthStateChanged }
      from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js';

    const app = initializeApp({
      apiKey: FIREBASE_API_KEY,
      authDomain: FIREBASE_AUTH_DOMAIN,
      projectId: FIREBASE_PROJECT_ID,
    });
    const auth = getAuth(app);
    const provider = new GoogleAuthProvider();

    function getRedirectTarget() {
      const params = new URLSearchParams(window.location.search);
      return params.get('redirect');
    }

    // 리다이렉트로 돌아온 직후인지 여부 — onAuthStateChanged가 아직 처리 중일 때
    // 잘못된 "로그아웃" 상태를 화면에 잠깐 그렸다가 다시 뒤집는 깜빡임(=반복되는 것처럼 보임)을 막기 위한 플래그
    let redirectPending = sessionStorage.getItem('tj_redirect_pending') === '1';

    function renderAuthUI(user) {
      const signinBtn = document.getElementById('btn-signin');
      const statusPanel = document.getElementById('statusPanel');
      const signoutBtn = document.getElementById('btn-signout');
      const statusEmail = document.getElementById('statusEmail');

      if (user) {
        sessionStorage.setItem('user_email', user.email);
        sessionStorage.removeItem('tj_redirect_pending');
        redirectPending = false;
        if (signinBtn) signinBtn.hidden = true;
        if (statusPanel) statusPanel.hidden = false;
        if (signoutBtn) signoutBtn.hidden = false;
        if (statusEmail) statusEmail.textContent = user.email;

        const modal = document.getElementById('auth-modal');
        if (modal) modal.hidden = true;

        const target = getRedirectTarget();
        if (target) {
          window.location.href = target;
        }
      } else if (!redirectPending) {
        // 리다이렉트 처리 대기 중이 아닐 때만 로그아웃 상태로 확정
        sessionStorage.removeItem('user_email');
        if (signinBtn) signinBtn.hidden = false;
        if (statusPanel) statusPanel.hidden = true;
      }
    }

    onAuthStateChanged(auth, renderAuthUI);

    // 리다이렉트 로그인 후 돌아왔을 때 결과 처리 (팝업 방식의 COOP/서드파티쿠키 차단 문제 회피)
    getRedirectResult(auth)
      .then((result) => {
        sessionStorage.removeItem('tj_redirect_pending');
        redirectPending = false;
        if (result && result.user) {
          // onAuthStateChanged를 기다리지 않고 즉시 확정 — 반복 현상의 핵심 수정 지점
          renderAuthUI(result.user);
        }
      })
      .catch((e) => {
        sessionStorage.removeItem('tj_redirect_pending');
        redirectPending = false;
        console.error('redirect result error', e);
        const err = document.getElementById('login-error');
        const detail = document.getElementById('login-error-detail');
        if (err) err.style.display = 'block';
        if (detail) detail.textContent = `[${e.code || 'unknown'}] ${e.message || e}`;
        const modal = document.getElementById('auth-modal');
        if (modal) modal.hidden = false;
      });

    document.getElementById('btn-signin')?.addEventListener('click', () => {
      document.getElementById('auth-modal').hidden = false;
    });

    document.getElementById('btn-signout')?.addEventListener('click', async () => {
      await signOut(auth);
      sessionStorage.removeItem('user_email');
    });

    document.getElementById('modal-close-btn')?.addEventListener('click', () => {
      document.getElementById('auth-modal').hidden = true;
    });

    document.getElementById('google-btn')?.addEventListener('click', async () => {
      const err = document.getElementById('login-error');
      const detail = document.getElementById('login-error-detail');
      const googleBtn = document.getElementById('google-btn');
      err.style.display = 'none';
      if (googleBtn) googleBtn.disabled = true;

      // 팝업 방식 우선 시도 — 같은 창에서 즉시 로그인 상태를 받아오므로
      // 리다이렉트 방식에서 발생하던 세션 유실/반복 문제를 원천적으로 피함
      try {
        const result = await signInWithPopup(auth, provider);
        if (result && result.user) {
          renderAuthUI(result.user);
        }
      } catch (popupError) {
        console.error('popup sign-in error', popupError);

        // 팝업이 차단되었거나 사용자가 닫은 경우 등에는 리다이렉트 방식으로 폴백
        const fallbackCodes = [
          'auth/popup-blocked',
          'auth/popup-closed-by-user',
          'auth/cancelled-popup-request',
          'auth/operation-not-supported-in-this-environment',
        ];
        if (fallbackCodes.includes(popupError.code)) {
          try {
            sessionStorage.setItem('tj_redirect_pending', '1');
            redirectPending = true;
            await signInWithRedirect(auth, provider);
            return;
          } catch (redirectError) {
            sessionStorage.removeItem('tj_redirect_pending');
            redirectPending = false;
            console.error('redirect sign-in error', redirectError);
            err.style.display = 'block';
            if (detail) detail.textContent = `[${redirectError.code || 'unknown'}] ${redirectError.message || redirectError}`;
          }
        } else {
          err.style.display = 'block';
          if (detail) detail.textContent = `[${popupError.code || 'unknown'}] ${popupError.message || popupError}`;
        }
      } finally {
        if (googleBtn) googleBtn.disabled = false;
      }
    });

    setTimeout(() => {
      const s = document.getElementById('splash');
      if (s) { s.style.opacity = '0'; setTimeout(() => s.remove(), 500); }
    }, 500);
  </script>

  <!-- 다른 페이지에서 선택한 언어를 이 페이지에서도 즉시 이어서 적용 -->
  <div id="google_translate_element" style="display:none"></div>
  <script>
    document.querySelectorAll('[class*="-kr"]').forEach((el) => {
      el.classList.add('notranslate');
      el.setAttribute('translate', 'no');
    });

    // 모바일에서는 구글 번역 위젯 로딩이 PC보다 훨씬 느릴 수 있어 재시도 대기 시간을 늘림(최대 약 20초)
    let authTranslateReady = false;
    function authTranslatePage(code) {
      if (code === 'ko') {
        const combo = document.querySelector('.goog-te-combo');
        if (combo) { combo.value = ''; combo.dispatchEvent(new Event('change')); }
        document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
        return;
      }
      const gCode = code === 'zh-HK' ? 'zh-TW' : code;
      const trySetCombo = (attempt) => {
        const combo = document.querySelector('.goog-te-combo');
        if (combo) {
          authTranslateReady = true;
          combo.value = gCode;
          combo.dispatchEvent(new Event('change'));
        } else if (attempt < 45) {
          setTimeout(() => trySetCombo(attempt + 1), 450);
        }
      };
      trySetCombo(0);
    }

    window.googleTranslateElementInit = function () {
      new google.translate.TranslateElement({ pageLanguage: 'ko', autoDisplay: false }, 'google_translate_element');
      authTranslateReady = true;
      const saved = localStorage.getItem('taerijay_lang');
      if (saved && saved !== 'ko') authTranslatePage(saved);
    };

    const authBackBtn = document.getElementById('auth-back-btn');
    if (authBackBtn) {
      authBackBtn.addEventListener('click', () => {
        if (window.history.length > 1) history.back();
        else window.location.href = '/';
      });
    }

    const authLangTrigger = document.getElementById('auth-lang-trigger');
    const authLangMenu = document.getElementById('auth-lang-menu');
    const authLangCurrent = document.getElementById('auth-lang-current');
    if (authLangTrigger) {
      authLangTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        authLangMenu.hidden = !authLangMenu.hidden;
      });
      document.querySelectorAll('.header-lang-option').forEach((opt) => {
        opt.addEventListener('click', () => {
          authLangCurrent.textContent = opt.dataset.name;
          localStorage.setItem('taerijay_lang', opt.dataset.code);
          authLangMenu.hidden = true;
          authTranslatePage(opt.dataset.code);
        });
      });
      document.addEventListener('click', (e) => {
        if (!authLangMenu.hidden && !e.target.closest('.header-lang-dropdown')) authLangMenu.hidden = true;
      });
      const saved = localStorage.getItem('taerijay_lang');
      if (saved) {
        const opt = document.querySelector(`.header-lang-option[data-code="${saved}"]`);
        if (opt) authLangCurrent.textContent = opt.dataset.name;
      }
    }
  </script>
  <script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" defer></script>
  <style is:global>
    .goog-te-banner-frame, .skiptranslate iframe { display:none!important; }
    body{top:0!important; position:static!important;}
    .goog-text-highlight{background:none!important; box-shadow:none!important;}
    #google_translate_element{display:none!important;}
  </style>
</body>
</html>