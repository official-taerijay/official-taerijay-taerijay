---
import Layout from '../layouts/Layout.astro';

const channels = {
  entertainment: { slug: 'entertainment', color: '#00E5FF', region: 'Seoul' },
  protocol:      { slug: 'protocol',      color: '#F16B24', payKey: 'protocol', region: 'Seorak' },
  mini:          { slug: 'mini',          color: '#e8e4dc', payKey: 'mini', region: 'Jeonju' },
  daiso:         { slug: 'daiso',         color: '#E1261C', payKey: 'daiso', region: 'Gyeongju' },
  oliveyoung:    { slug: 'oliveyoung',    color: '#6F8B2E', payKey: 'olive', region: 'Busan' },
  emartCvs:      { slug: 'emart-convenience', color: '#FFDD00', payKey: 'emart_cvs', region: 'Jeju' },
};

const singleTiers = [
  { color: '#FBF9F4', price: '19.99', en: 'BASIC',    key: 'basic',    id: 1, device: 1, concurrent: 1 },
  { color: '#22C55E', price: '29.99', en: 'STANDARD', key: 'standard', id: 1, device: 2, concurrent: 2 },
  { color: '#F16B24', price: '39.99', en: 'PRO',      key: 'pro',      id: 1, device: 4, concurrent: 4 },
];

const doublePlans = [
  { color: '#2DD4BF', a: 'protocol', b: 'mini', payKey: 'protocol_mini' },
  { color: '#818CF8', a: 'daiso', b: 'oliveyoung', payKey: 'daiso_olive' },
];

const USD_KRW = 1400;
const krw = (usd) => Math.round(usd * USD_KRW).toLocaleString('ko-KR');
---
<Layout title="요금제 | TAERIJAY">
  <div class="pricing-page">
    <div class="pricing-topbar">
      <button type="button" class="back-btn" onclick="history.back()">← 뒤로가기</button>
    </div>

    <section class="pricing-hero">
      <p class="pricing-eyebrow-kr">요금제</p>
      <p class="pricing-eyebrow-en" data-i18n="en">PRICING</p>
      <p class="pricing-sub-kr">필요한 채널 선택, 필요한 만큼만 결제</p>
      <p class="pricing-sub-en" data-i18n="en">Select only the channels you need</p>
    </section>

    <!-- 싱글 요금제 상세 -->
    <section class="pricing-block">
      <h2 class="pricing-block-title">
        <span class="pricing-block-title-kr">싱글 요금제</span>
        <span class="pricing-block-title-en" data-i18n="en">SINGLE PLAN</span>
      </h2>
      <p class="pricing-block-desc-kr">유료 채널 1개 선택, 3가지 등급 중 필요에 맞게 선택</p>
      <p class="pricing-block-desc-en" data-i18n="en">1 paid channel · 3 tiers to choose from</p>

      <div class="pricing-warning">
        <p class="pricing-warning-kr">⚠️ 디바이스·동시접속 초과 시 경고 표시, 초과분 접속 제한</p>
        <p class="pricing-warning-en" data-i18n="en">⚠️ Over limit → warning + access restricted</p>
      </div>

      {singleTiers.map((t) => (
        <div class="tier-group">
          <div class="tier-group-header" style={`--tc:${t.color}`}>
            <span class="tier-group-price">USD {t.price}</span>
            <span class="tier-group-krw">₩{krw(parseFloat(t.price))}</span>
            <span class="tier-group-en" data-i18n="en">{t.en}</span>
            <ul class="plan-specs plan-specs-inline">
              <li><span class="spec-kr">아이디 {t.id}</span><span class="spec-en" data-i18n="en">{t.id} ID</span></li>
              <li><span class="spec-kr">디바이스 {t.device}</span><span class="spec-en" data-i18n="en">{t.device} Device{t.device > 1 ? 's' : ''}</span></li>
              <li><span class="spec-kr">동시접속 {t.concurrent}</span><span class="spec-en" data-i18n="en">{t.concurrent} Concurrent</span></li>
            </ul>
          </div>
          <div class="plan-detail-list">
            {Object.entries(channels).filter(([slug]) => slug !== 'entertainment').map(([slug, ch]) => (
              <div class="plan-detail-row">
                <span class="plan-detail-label">
                  <span class="plan-detail-label-kr">싱글 요금제</span>
                  <span class="plan-detail-label-en" data-i18n="en">SINGLE</span>
                </span>
                <a href={`/02-payment?key=${ch.payKey}_${t.key}`} class="plan-detail-box plan-detail-box-media" style={`--tc:${ch.color};--hero-img:url('/images/channels/${ch.slug === 'emart-convenience' ? 'emart' : slug}.jpg')`}>
                  <span class="plan-detail-names" style={`color:${ch.color}`}>taerijay+{slug === 'emartCvs' ? 'emart+convenience' : slug}</span>
                  <span class="plan-detail-price-wrap">
                    <span class="plan-detail-price">USD {t.price}</span>
                    <span class="plan-detail-krw">₩{krw(parseFloat(t.price))}</span>
                  </span>
                </a>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- 더블 요금제 상세 -->
    <section class="pricing-block">
      <h2 class="pricing-block-title">
        <span class="pricing-block-title-kr">더블 요금제</span>
        <span class="pricing-block-title-en" data-i18n="en">DOUBLE PLAN</span>
      </h2>
      <p class="pricing-block-desc-kr">연관 채널 2개 묶음, 할인 가격 적용</p>
      <p class="pricing-block-desc-en" data-i18n="en">2 related channels bundled at a discount</p>

      <ul class="plan-specs plan-specs-inline">
        <li><span class="spec-kr">아이디 1</span><span class="spec-en" data-i18n="en">1 ID</span></li>
        <li><span class="spec-kr">디바이스 1</span><span class="spec-en" data-i18n="en">1 Device</span></li>
        <li><span class="spec-kr">동시접속 1</span><span class="spec-en" data-i18n="en">1 Concurrent</span></li>
      </ul>
      <p class="plan-specs-note-kr">번들 상품은 계정 공유 방지를 위해 1기기로 제한됩니다.</p>
      <p class="plan-specs-note-en" data-i18n="en">Bundle plans are limited to 1 device to prevent account sharing.</p>

      <div class="plan-detail-list">
        {doublePlans.map((dp) => (
          <div class="plan-detail-row">
            <span class="plan-detail-label">
              <span class="plan-detail-label-kr">더블 요금제</span>
              <span class="plan-detail-label-en" data-i18n="en">DOUBLE</span>
            </span>
            <a href={`/02-payment?key=${dp.payKey}`} class="plan-detail-box" style={`--tc:${dp.color}`}>
              <span class="plan-detail-names-wrap">
                <span class="plan-detail-prefix">taerijay+</span>
                <span class="plan-detail-combo">
                  <span style={`color:${channels[dp.a].color}`}>{dp.a}</span>
                  <span class="plan-detail-x">×</span>
                  <span style={`color:${channels[dp.b].color}`}>{dp.b}</span>
                </span>
              </span>
              <span class="plan-detail-price-wrap">
                <span class="plan-detail-price">USD 34.99</span>
                <span class="plan-detail-krw">₩{krw(34.99)}</span>
              </span>
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- 토탈 요금제 상세 -->
    <section class="pricing-block">
      <h2 class="pricing-block-title">
        <span class="pricing-block-title-kr" style="color:#B33A52">토탈 요금제</span>
        <span class="pricing-block-title-en" style="color:#B33A52" data-i18n="en">TOTAL PLAN</span>
      </h2>
      <p class="pricing-block-desc-kr">유료 채널 5개 전체 이용, 신규 채널 자동 포함</p>
      <p class="pricing-block-desc-en" data-i18n="en">All 5 paid channels, new channels included automatically</p>

      <ul class="plan-specs plan-specs-inline">
        <li><span class="spec-kr">아이디 1</span><span class="spec-en" data-i18n="en">1 ID</span></li>
        <li><span class="spec-kr">디바이스 1</span><span class="spec-en" data-i18n="en">1 Device</span></li>
        <li><span class="spec-kr">동시접속 1</span><span class="spec-en" data-i18n="en">1 Concurrent</span></li>
      </ul>
      <p class="plan-specs-note-kr">번들 상품은 계정 공유 방지를 위해 1기기로 제한됩니다.</p>
      <p class="plan-specs-note-en" data-i18n="en">Bundle plans are limited to 1 device to prevent account sharing.</p>

      <div class="plan-detail-row plan-detail-row-total">
        <span class="plan-detail-label">
          <span class="plan-detail-label-kr" style="color:#B33A52">토탈 요금제</span>
          <span class="plan-detail-label-en" style="color:#B33A52" data-i18n="en">TOTAL</span>
        </span>
        <a href="/02-payment?key=total" class="plan-detail-box plan-detail-box-total">
          <span class="total-detail-heading" data-i18n="en">ALL SERVICES</span>
          <div class="total-detail-names">
            {Object.entries(channels).filter(([slug]) => slug !== 'entertainment').map(([slug, ch]) => (
              <span class="total-chip-line" style={`color:${ch.color}`}>taerijay+{slug === 'emartCvs' ? 'emart+convenience' : slug}</span>
            ))}
          </div>
          <span class="plan-detail-price-wrap">
            <span class="plan-detail-price">USD 99.99</span>
            <span class="plan-detail-krw">₩{krw(99.99)}</span>
          </span>
        </a>
      </div>
    </section>
  </div>

  <style>
    .pricing-page{width:var(--container);margin:0 auto;padding:24px 0 90px}
    .pricing-topbar{margin-bottom:20px;padding-top:88px}
    .back-btn{background:transparent;border:1px solid rgba(255,255,255,.2);color:var(--ivory);font-size:.8rem;font-weight:600;padding:8px 16px;border-radius:100px;cursor:pointer;transition:background .2s}
    .back-btn:hover{background:rgba(255,255,255,.1)}

    .pricing-hero{padding-bottom:32px;border-bottom:1px solid rgba(255,255,255,.08);margin-bottom:44px}
    .pricing-eyebrow-kr{font-size:.82rem;font-weight:700;color:var(--muted);margin-bottom:2px}
    .pricing-eyebrow-en{font-size:.98rem;letter-spacing:.08em;font-weight:700;color:var(--gold);text-transform:uppercase;margin-bottom:16px}
    .pricing-sub-kr{font-size:.95rem;color:var(--ivory);margin-bottom:2px}
    .pricing-sub-en{font-size:1.05rem;color:var(--muted)}

    .pricing-block{margin-bottom:56px}
    .pricing-block-title{display:flex;align-items:baseline;flex-wrap:wrap;gap:10px;margin-bottom:10px}
    .pricing-block-title-kr{font-family:var(--f-display);font-weight:900;font-size:1.4rem}
    .pricing-block-title-en{font-size:1.02rem;letter-spacing:.06em;font-weight:700;color:var(--dim);text-transform:uppercase}
    .pricing-block-desc-kr{font-size:.88rem;color:var(--ivory);line-height:1.6;margin-bottom:2px}
    .pricing-block-desc-en{font-size:1rem;color:var(--muted);line-height:1.5;margin-bottom:8px}

    .tier-group{margin:22px 0 30px;border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:20px;background:rgba(255,255,255,.015)}
    .tier-group-header{border-left:4px solid var(--tc);padding-left:16px;margin-bottom:14px}
    .tier-group-price{font-family:var(--f-display);font-weight:900;font-size:1.5rem;color:var(--tc);margin-right:10px}
    .tier-group-krw{font-size:.82rem;font-weight:600;color:var(--dim);margin-right:10px}
    .tier-group-en{font-size:1.05rem;font-weight:700;color:var(--ivory);letter-spacing:.03em}

    .plan-specs{list-style:none;margin:6px 0}
    .plan-specs li{margin-bottom:6px}
    .plan-specs-inline{display:flex;flex-direction:column;gap:2px;margin-bottom:18px}
    .plan-specs-note-kr{font-size:.76rem;color:var(--dim);margin-bottom:1px}
    .plan-specs-note-en{font-size:.8rem;color:var(--dim);opacity:.8;margin-bottom:18px}
    .spec-kr{display:block;font-size:.82rem;color:var(--ivory)}
    .spec-en{display:block;font-size:.86rem;color:var(--dim)}

    .pricing-warning{border:1px solid rgba(241,107,36,.35);background:rgba(241,107,36,.08);border-radius:10px;padding:14px 18px;margin-bottom:26px}
    .pricing-warning-kr{font-size:.82rem;color:#F16B24;line-height:1.6;margin-bottom:2px}
    .pricing-warning-en{font-size:.9rem;color:#F16B24;opacity:.85;line-height:1.5}

    .pricing-pick-hint-kr{font-size:.8rem;color:var(--ivory);margin-bottom:1px}
    .pricing-pick-hint-en{font-size:.86rem;color:var(--dim);margin-bottom:18px}

    /* 싱글/더블/토탈 공통 행(row) 레이아웃 — 통일된 카드 스타일 */
    .plan-detail-list{display:flex;flex-direction:column;gap:0;margin-top:12px}
    .plan-detail-row{display:flex;align-items:center;gap:18px;padding:14px 0;border-bottom:1px solid rgba(255,255,255,.08);flex-wrap:wrap}
    .plan-detail-row-total{border-bottom:none;padding-top:6px}
    .plan-detail-label{flex:0 0 110px;display:flex;flex-direction:column;gap:2px}
    .plan-detail-label-kr{font-size:.78rem;font-weight:700;color:var(--muted)}
    .plan-detail-label-en{font-size:.84rem;font-weight:600;letter-spacing:.05em;color:var(--dim);text-transform:uppercase}
    .plan-detail-box{font:inherit;width:100%;text-decoration:none;cursor:pointer;border:2px solid var(--tc);border-radius:10px;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex:1;background:color-mix(in srgb, var(--tc) 8%, transparent);transition:background .2s,transform .15s;color:inherit}
    .plan-detail-box:hover{background:color-mix(in srgb, var(--tc) 18%, transparent);transform:translateY(-1px)}
    .plan-detail-box-media{position:relative;overflow:hidden;background-image:var(--hero-img, none), color-mix(in srgb, var(--tc) 8%, transparent);background-size:cover;background-position:center}
    .plan-detail-box-media::before{content:'';position:absolute;inset:0;background:linear-gradient(90deg, rgba(6,10,18,.82) 0%, rgba(6,10,18,.55) 60%, rgba(6,10,18,.3) 100%);z-index:0}
    .plan-detail-box-media:hover{background-image:var(--hero-img, none), color-mix(in srgb, var(--tc) 18%, transparent)}
    .plan-detail-box-media > *{position:relative;z-index:1}
    .plan-detail-names{font-weight:700;font-size:1rem}
    .plan-detail-names-wrap{display:flex;flex-direction:column;gap:2px}
    .plan-detail-prefix{font-size:.72rem;font-weight:700;color:var(--dim);letter-spacing:.03em}
    .plan-detail-combo{font-family:var(--f-display);font-weight:700;font-size:1.05rem}
    .plan-detail-x{color:var(--dim);margin:0 8px}
    .plan-detail-price-wrap{display:flex;flex-direction:column;align-items:flex-end;gap:0}
    .plan-detail-price{font-weight:900;font-size:1.2rem;color:var(--tc);white-space:nowrap}
    .plan-detail-krw{font-size:.78rem;font-weight:600;color:var(--dim);white-space:nowrap}

    .plan-detail-box-total{display:block;border:1px solid #B33A52;background:linear-gradient(160deg, rgba(179,58,82,.12) 0%, rgba(179,58,82,.02) 100%);min-width:260px}
    .plan-detail-box-total:hover{background:linear-gradient(160deg, rgba(179,58,82,.22) 0%, rgba(179,58,82,.05) 100%)}
    .total-detail-heading{display:block;font-weight:800;font-size:1rem;color:var(--ivory);margin-bottom:14px}
    .total-detail-names{display:flex;flex-direction:column;gap:6px;margin-bottom:18px}
    .total-chip-line{font-size:.9rem;font-weight:700}
    .plan-detail-box-total .plan-detail-price{font-size:1.8rem}
    .plan-detail-box-total .plan-detail-krw{font-size:.9rem}

    @media (max-width: 560px){
      .plan-detail-row{flex-direction:column;align-items:flex-start;gap:8px}
      .plan-detail-label{flex:none}
      .plan-detail-box{flex-direction:column;align-items:flex-start;gap:8px}
      .plan-detail-price{font-size:1.05rem}
      .tier-group{padding:16px}
    }
  </style>
</Layout>
